# SonarCloud — copia questo file in .env e compila i valori.
# .env è già coperto da .gitignore (riga `.env`), non verrà committato.

# Token utente SonarCloud: https://sonarcloud.io/account/security
SONAR_TOKEN=

# Organization key (in SonarCloud: Administration > Organization key)
SONAR_ORGANIZATION=

# Project key (nella pagina del progetto: Information > Project Key)
SONAR_PROJECT_KEY=

# Opzionale: per SonarQube self-hosted. Default: https://sonarcloud.io
# SONAR_HOST=https://sonarcloud.io
