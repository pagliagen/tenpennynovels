# ========================================
# TenPennyNovels - Embeddings Worker
# Production Environment Configuration
# ========================================
# Copy this file to: services/embeddings-worker/.env.production

# Environment
NODE_ENV=production

# HTTP Server port (serves /health and /search endpoints)
HTTP_PORT=5001

# Python interpreter for sentence-transformers subprocess
PYTHON_PATH=python3

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tenpennynovels

# Redis (Bull queue)
REDIS_URL=redis://127.0.0.1:6379

# Qdrant (vector database)
QDRANT_URL=http://127.0.0.1:6333
# Opzionale: solo se Qdrant gira con QDRANT__SERVICE__API_KEY impostata (vedi RUNBOOK_SERVER1.md)
QDRANT_API_KEY=

# ElasticSearch (full-text search for hybrid search)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=tenpennynovels
# Opzionali: solo se Elasticsearch gira con xpack.security.enabled=true (vedi RUNBOOK_SERVER1.md)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Ollama (RAG "Bibliotecario")
# Il modello determina la velocità: l'inferenza CPU è limitata dalla banda di
# memoria, quindi il tempo di risposta scala con la dimensione del modello.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# I modelli reasoning consumano num_predict in token di <think> prima di
# rispondere: su CPU è il costo dominante. Mettere a true solo per confronti.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096

# Budget prompt/risposta del Bibliotecario.
# unified-backend aborta /ask dopo 60s: prefill + decode devono starci dentro.
QA_MAX_ANSWER_TOKENS=250
QA_MAX_CONTEXT_CHARS=6000
QA_MAX_CHUNK_CHARS=1500

# Logging
LOG_LEVEL=info
