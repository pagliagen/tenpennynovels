# ========================================
# TenPennyNovels - API Gateway
# Production Environment Configuration
# ========================================
# Copy this file to: services/api-gateway/.env.production
#
# Il gateway legge davvero da process.env solo:
#   - NODE_ENV (production → trust proxy, CORS prod, log level)
#   - CDN_STORAGE_PATH (path file statici /cdn; default /cdn-storage)
# In produzione l'URL del unified-backend e la porta 8000 sono fissati in src/config.ts
# (127.0.0.1:3001 e 8000). Le variabili sotto "Legacy / documentazione" non sono lette dal codice
# attuale: servono solo se in futuro allineerai config.ts a questo template.

# Environment
NODE_ENV=production

# Obbligatorio se usi /cdn sul gateway con storage su disco VPS
CDN_STORAGE_PATH=/var/www/cdn-cache

# --- Legacy / documentazione (non usate da services/api-gateway/src/config.ts) ---
PORT=8000
UNIFIED_BACKEND_URL=http://127.0.0.1:3001
GAME_BACKEND_URL=http://127.0.0.1:3001
AUTH_BACKEND_URL=http://127.0.0.1:3001
MANAGEMENT_BACKEND_URL=http://127.0.0.1:3001
DOCUMENTS_BACKEND_URL=http://127.0.0.1:3001
TICKETS_BACKEND_URL=http://127.0.0.1:3001
FORUM_BACKEND_URL=http://127.0.0.1:3001
TRUST_PROXY=true
LANDING_URL=https://tenpennynovels.com
GAME_URL=https://game.tenpennynovels.com
DOCUMENTS_URL=https://documenti.tenpennynovels.com
MANAGEMENT_URL=https://gestione.tenpennynovels.com
LOG_LEVEL=info
