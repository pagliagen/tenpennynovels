# ========================================
# TenpennyNovels - Embeddings Worker
# Production Environment Configuration
# ========================================
# Copy this file to: services/embeddings-worker/.env.production

# Environment
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tenpennynovels

# Redis (Bull queue)
REDIS_URL=redis://127.0.0.1:6379

# Qdrant (vector database)
QDRANT_URL=http://127.0.0.1:6333

# Embeddings Service (internal)
EMBEDDINGS_SERVICE_URL=http://127.0.0.1:5001

# Logging
LOG_LEVEL=info
