# ========================================
# TenPennyNovels - API Gateway
# Production Environment Configuration
# ========================================
# Copy this file to: services/api-gateway/.env.production

# Environment
NODE_ENV=production
PORT=8000

# Backend Service URLs (localhost - inter-service communication)
GAME_BACKEND_URL=http://127.0.0.1:3001

# Frontend URLs (public domains for CORS)
LANDING_URL=https://tenpennynovels.com
GAME_URL=https://game.tenpennynovels.com
DOCUMENTS_URL=https://documenti.tenpennynovels.com
MANAGEMENT_URL=https://gestione.tenpennynovels.com

# Logging
LOG_LEVEL=info
