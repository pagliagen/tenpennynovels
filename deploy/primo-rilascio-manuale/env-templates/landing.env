# ========================================
# TenpennyNovels - Landing App
# Production Environment Configuration
# ========================================
# Copy this file to: apps/landing/.env.production

# Environment
NODE_ENV=production

# API URLs (public endpoints)
NEXT_PUBLIC_API_URL=https://api.tenpennynovels.com
NEXT_PUBLIC_WS_URL=wss://ws.tenpennynovels.com

# Game App URL (for redirects after login/character selection)
NEXT_PUBLIC_GAME_URL=https://game.tenpennynovels.com
