# ========================================
# TenPennyNovels - Unified Backend
# Production Environment Configuration
# ========================================
# Copy this file to: services/unified-backend/.env.production

# Environment
NODE_ENV=production
PORT=3001

# ⚠️  CRITICAL SECURITY: Server must bind to 127.0.0.1 (localhost only)
# This prevents direct external access to the API (only via api-gateway)
# Verify in code: app.listen(PORT, '127.0.0.1')

# MongoDB (production database)
MONGODB_URI=mongodb://127.0.0.1:27017/tenpennynovels

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Qdrant (vector search for embeddings)
QDRANT_URL=http://127.0.0.1:6333

# JWT Secrets
# ⚠️  CHANGE THESE! Generate with: openssl rand -hex 64
JWT_SECRET=d7974d1f4ec5c71f89909a0fbd9542e4c7086a851035dcc8f7a34a3bc38a002fb4e50ebe0d6ab9cfd22fc02d5610ae498eefc268663990854a28545ce9cfe1e0
JWT_REFRESH_SECRET=0e0341085c95262a1bf6ffd701008a56a1c0fe922f3b58c3ae83affbc792d084ec8ad2cf0d4bc00f9357140d98b793e9be5f8993169fd994604371ffddfed05d

# Frontend URLs (for CORS configuration)
FRONTEND_URL=https://game.tenpennynovels.com
ALLOWED_ORIGINS=https://tenpennynovels.com,https://game.tenpennynovels.com,https://documenti.tenpennynovels.com,https://gestione.tenpennynovels.com

# Embeddings Service (internal)
EMBEDDINGS_SERVICE_URL=http://127.0.0.1:5001

# AI Gateway (local-ai via ngrok)
# local-ai runs locally, exposed via persistent ngrok URL
AI_GATEWAY_URL=https://onomatopoeically-unforgeable-ozie.ngrok-free.dev
AI_GATEWAY_CLIENT_ID=tpn-prod
# ⚠️  Generate with: openssl rand -hex 32 (must match client config in local-ai/.env)
AI_GATEWAY_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
AI_GATEWAY_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
AI_GATEWAY_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Public API URL (used by QA service to call back for additional searches)
# In prod: the internal URL the QA can reach (via ngrok or directly)
PUBLIC_API_URL=http://127.0.0.1:3001

# Email Configuration (SMTP)
# Provider: mail.tenpennynovels.com
EMAIL_FROM=info@tenpennynovels.com
SMTP_HOST=mail.tenpennynovels.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tenpennynovels.com
SMTP_PASS=AuGItRVFylw5

# CDN Storage & FTP Sync
CDN_STORAGE_PATH=/var/www/cdn-cache
CDN_BASE_URL=https://cdn.tenpennynovels.com
CDN_FTP_ENABLED=true
CDN_FTP_HOST=ftp.tenpennynovels.com
CDN_FTP_PORT=21
CDN_FTP_USER=cdn_upload
CDN_FTP_PASSWORD=CHANGE_ME
CDN_FTP_BASE_PATH=/
CDN_FTP_SECURE=true

# Logging
LOG_LEVEL=info
