# ========================================
# TenPennyNovels - Embeddings Service
# Production Environment Configuration
# ========================================
# Copy this file to: services/embeddings-service/.env

# Service Host & Port
EMBEDDINGS_SERVICE_HOST=127.0.0.1
EMBEDDINGS_SERVICE_PORT=5001

# Model Configuration
# Current: paraphrase-multilingual-MiniLM-L12-v2 (118MB, 384 dimensions, supports Italian)
# See: https://www.sbert.net/docs/pretrained_models.html
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
