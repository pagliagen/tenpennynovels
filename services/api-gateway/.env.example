# ================================================
# API Gateway - Variabili d'Ambiente
# ================================================
# La configurazione (porte, URL, CORS, CDN) è derivata
# da NODE_ENV in src/config.ts.
# NB: il .env vero NON va committato (vedi .gitignore).
# ================================================

NODE_ENV=development

# === Webhook secret ===
# Usato per validare le callback dei servizi interni (local-ai) su /webhooks.
# DEVE combaciare con AI_GATEWAY_WEBHOOK_SECRET di unified-backend e del gateway
# local-ai. Prima era hardcoded in ecosystem.config.js: ora va messo qui e RUOTATO.
AI_GATEWAY_WEBHOOK_SECRET=
