{
  "name": "botai-backend",
  "version": "1.0.0",
  "description": "TenPennyNovels - Bot AI Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "build:tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "docker:dev:start": "./scripts/start-dev.sh",
    "docker:dev:stop": "./scripts/stop-dev.sh",
    "docker:dev:logs": "./scripts/logs-dev.sh",
    "docker:prod:start": "./scripts/start-prod.sh",
    "docker:prod:stop": "./scripts/stop-prod.sh",
    "docker:prod:logs": "./scripts/logs-prod.sh",
    "cleanup:bots": "tsx scripts/cleanup-bots.ts"
  },
  "keywords": [
    "bot",
    "ai",
    "claude",
    "npc"
  ],
  "author": "Gennaro Paglia",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "axios": "^1.13.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.20.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.6",
    "morgan": "^1.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
