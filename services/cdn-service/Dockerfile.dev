# =============================================================================
# CDN Service - Development Dockerfile (hot-reload with tsx watch)
# =============================================================================
FROM node:22-alpine

# Install Sharp dependencies
RUN apk add --no-cache \
    build-base \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install ALL dependencies (including devDependencies for tsx)
RUN npm install

# Copy source code (will be overridden by volume mount in dev)
COPY src ./src

# Create storage directory
RUN mkdir -p /cdn-storage

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
  CMD node -e "require('http').get('http://localhost:${PORT:-4002}/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Expose port
EXPOSE 4002

# Start with tsx watch (hot-reload)
CMD ["npm", "run", "dev"]
