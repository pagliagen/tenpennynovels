{
  "_meta": {
    "version": "2.1.0",
    "description": "LEGACY admin panel permissions - DEPRECATED",
    "lastUpdated": "2026-03-05"
  },
  "admin_roles": {
    "personaggio": {
      "description": "Personaggio base - accesso limitato solo lettura",
      "permissions": [
        "admin:dashboard:access",
        "admin:dashboard:view_basic_stats",
        "admin:dashboard:view_character_stats",
        "admin:dashboard:view_gameplay_stats",
        "admin:tickets:access",
        "admin:tickets:create",
        "admin:tickets:read"
      ]
    },
    "moderatore": {
      "description": "Moderatore - gestione utenti e contenuti",
      "inherits": "personaggio",
      "permissions": [
        "admin:dashboard:view_user_count",
        "admin:users:access",
        "admin:users:read",
        "admin:users:ban",
        "admin:content:access",
        "admin:content:read",
        "admin:content:create",
        "admin:content:update",
        "admin:content:delete",
        "admin:content:publish",
        "admin:documents:access",
        "admin:documents:read",
        "admin:documents:create",
        "admin:documents:update",
        "admin:documents:delete",
        "admin:documents:manage_groups",
        "admin:system:access",
        "admin:system:broadcast_messages",
        "admin:tickets:assign",
        "admin:tickets:close"
      ]
    },
    "master": {
      "description": "Game Master - gestione gameplay completa",
      "inherits": "moderatore",
      "permissions": [
        "admin:dashboard:view_financial_stats",
        "admin:characters:access",
        "admin:characters:read",
        "admin:characters:approve",
        "admin:characters:reject",
        "admin:characters:edit",
        "admin:economy:access",
        "admin:economy:view_transactions",
        "admin:economy:grant_money",
        "admin:economy:adjust_balances",
        "admin:economy:view_reports",
        "admin:locations:access",
        "admin:locations:read",
        "admin:locations:create",
        "admin:locations:update",
        "admin:locations:manage_access",
        "admin:gamedata:access",
        "admin:gamedata:read",
        "admin:gamedata:create",
        "admin:gamedata:update",
        "admin:skills:access",
        "admin:skills:view",
        "admin:skills:create",
        "admin:skills:update",
        "admin:occupations:access",
        "admin:occupations:view",
        "admin:occupations:create",
        "admin:occupations:update",
        "admin:tickets:manage_all"
      ]
    },
    "amministratore": {
      "description": "Amministratore - accesso avanzato senza manutenzione",
      "inherits": "master",
      "permissions": [
        "admin:dashboard:view_system_health",
        "admin:dashboard:view_activity_logs",
        "admin:users:update",
        "admin:system:view_logs",
        "admin:system:export_data",
        "admin:locations:delete",
        "admin:gamedata:delete",
        "admin:skills:delete",
        "admin:occupations:delete",
        "admin:tickets:transfer",
        "admin:tickets:internal_notes"
      ]
    }
  },
  "user_roles": {
    "user": {
      "description": "Utente standard"
    },
    "gestore": {
      "description": "Gestore - Accesso completo sistema (override tutti i permessi character)"
    }
  },
  "manager_permissions": {
    "manager.manage_user_permissions": {
      "description": "Gestire ruoli USER e gate admin panel (solo gestore)",
      "roles": ["gestore"]
    }
  },
