  "_gameplay_roles_mapping": {
    "description": "Mapping between admin characterRoles (this file) and game gameplayRoles (game-permissions.json)",
    "note": "characterRoles are assigned in admin panel, gameplayRoles are auto-set based on character.status",
    "mapping": {
      "personaggio": {
        "gameplayRole": "player (DRAFT) or approved-player (APPROVED)",
        "autoAssignedOn": "Character creation (DRAFT status)",
        "upgradesTo": "approved-player when status becomes APPROVED"
      },
      "master": {
        "gameplayRole": "master",
        "autoAssignedOn": "When characterRoles includes 'master'",
        "inherits": "All permissions from approved-player role"
      },
      "moderatore": {
        "gameplayRole": "moderatore",
        "autoAssignedOn": "When characterRoles includes 'moderatore'",
        "inherits": "All permissions from approved-player role",
        "specialPermissions": "Chat moderation actions and content moderation"
      },
      "gestore": {
        "gameplayRole": "Bypasses all game permissions (isGestore flag)",
        "autoAssignedOn": "When isGestore=true on Character model",
        "permissions": "ALL (wildcard game:*)"
      }
    }
