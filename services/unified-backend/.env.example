# ================================================
# Unified Backend - Variabili d'Ambiente
# ================================================
# Solo segreti e connessioni infrastruttura.
# Tutto il resto è gestito da appConfig.ts
# NB: il .env vero NON va committato (vedi .gitignore).
# ================================================

NODE_ENV=development

# === Database ===
# In PRODUZIONE i DB sono servizi NATIVI sul VPS dedicato (non Docker):
#   Mongo con auth abilitata, Redis, Qdrant, ElasticSearch (heap 512m).
#   Esempio prod (adatta credenziali/host reali):
#   MONGODB_URI=mongodb://tpn_app:<password>@127.0.0.1:27017/tenpennynovels?authSource=admin
#   REDIS_URL=redis://127.0.0.1:6379
MONGODB_URI=mongodb://localhost:27017/tenpennynovels
REDIS_URL=redis://localhost:6379

# Qdrant + Embeddings worker (nativi sul VPS)
QDRANT_URL=http://127.0.0.1:6333
EMBEDDINGS_SERVICE_URL=http://127.0.0.1:5001

# === JWT (obbligatori) ===
JWT_SECRET=
JWT_REFRESH_SECRET=

# === SMTP (obbligatori in produzione) ===
SMTP_USER=
SMTP_PASSWORD=

# === Admin Notifications ===
ADMIN_EMAIL=admin@tenpennynovels.com

# === Documents app — ISR on-demand revalidation ===
# Deve combaciare col valore di DOCUMENTS_REVALIDATE_SECRET in apps/documents/.env.
# Senza questo, il salvataggio di un documento nel gestionale non aggiorna la
# pagina statica su documenti.tenpennynovels.com prima di 1h (revalidate: 3600).
DOCUMENTS_REVALIDATE_SECRET=

# === CDN FTP (obbligatori in produzione) ===
CDN_FTP_HOST=
CDN_FTP_USER=
CDN_FTP_PASSWORD=

# === Altro (obbligatorio in produzione) ===
# Utente proprietario dei personaggi bot (isBot: true). ID fisso creato da UserSeeder:
# stesso valore su ogni ambiente dove gira il seeder, non serve generarlo ogni volta.
SYSTEM_BOT_USER_ID=000000000000000000000001

# Servizio bot locale (bot-service/): abilita POST /internal/bot-chat/messages.
# Senza valore l endpoint risponde 404. Generare con: openssl rand -hex 32
# BOT_SERVICE_SECRET=

# Funzioni editoriali con il modello (bozze di descrizioni, dicerie).
# ENABLE_IA_EDITORIAL=true = «l'AI è abilitata»; è DAVVERO attiva solo se il gateway AI (ai-gateway/) risponde e
# dichiara il servizio `editorial`. Senza gateway le loro route rispondono 404 e il gestionale non mostra i pulsanti AI.
# La revisione di canone (/admin/editorial/canon-check) è sempre attiva e non dipende da queste variabili.
# ENABLE_IA_EDITORIAL=false
# Tab «Bot» del gestionale (elenco e generazione dei bot). Con «true» è attivo solo se il gateway AI dichiara il servizio
# `character-bot`. Non accende il bot di chat (quello dipende da BOT_SERVICE_SECRET). Ambiente dei bot: APP_ENVIRONMENT (default
# `production` con NODE_ENV=production, altrimenti `local`).
# ENABLE_BOT_CHARACTERS=false
# AI_GATEWAY_URL=https://onomatopoeically-unforgeable-ozie.ngrok-free.dev
# AI_GATEWAY_SECRET=
# Opzionali: validità della sonda a /health (la sonda è pigra, mai da un timer: il tunnel ha una quota di richieste)
# AI_GATEWAY_PROBE_OK_TTL_MS=60000
# AI_GATEWAY_PROBE_FAIL_TTL_MS=10000
