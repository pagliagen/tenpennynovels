{
  "name": "@tenpennynovels/unified-backend",
  "version": "1.0.0",
  "description": "TenPennyNovels - Unified Backend (All Modules)",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "./dist",
    "@shared": "./dist/shared",
    "@modules": "./dist/modules",
    "@database": "./dist/database",
    "@config": "./dist/config"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node bootstrap.js",
    "type-check": "tsc --noEmit",
    "migrate:social-conflict": "tsx src/database/migrations/migrate-social-conflict.ts",
    "seed:skill-confrontations": "tsx src/database/seeds/skill-confrontations.ts",
    "generate:sitemap": "tsx src/scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/ioredis": "^4.28.10",
    "axios": "^1.13.5",
    "basic-ftp": "^5.2.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "geoip-lite": "^1.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongoose": "^9.8.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "redis": "^5.11.0",
    "redlock": "^5.0.0-beta.2",
    "sanitize-html": "^2.17.6",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "suncalc": "^1.9.0",
    "ua-parser-js": "^2.0.9", 
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/suncalc": "^1.9.2",
    "@types/ua-parser-js": "^0.7.39",
    "@types/validator": "^13.15.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "htmlparser2": "^9.1.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
