# =============================================================================
# TenPennyNovels - Unified Backend Dockerfile (Development)
# Development mode con tsx watch (no build, hot reload).
# In produzione unified-backend gira via PM2 sull'host, non da un container.
# =============================================================================

FROM node:24-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies dal lockfile (versioni bloccate — S8543).
# --ignore-scripts: nessun lifecycle script dalle dipendenze transitive (S6505).
# bcrypt e tsx/esbuild funzionano lo stesso: i binari nativi arrivano da
# optionalDependencies prebuilt, non da postinstall (verificato con build+run).
# tsx è già in devDependencies.
RUN npm ci --ignore-scripts

# Copy source code (esplicito: niente COPY . . — S6470)
COPY tsconfig.json ./
COPY src ./src

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start with tsx watch for hot reload
CMD ["./node_modules/.bin/tsx", "watch", "src/server.ts"]
