{
  "name": "@tenpennynovels/embeddings-worker",
  "version": "1.0.0",
  "description": "TenPennyNovels - Embeddings Worker",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsx watch -r dotenv/config src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "mongoose": "^9.8.0",
    "ollama": "^0.6.3",
    "redis": "^6.1.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
