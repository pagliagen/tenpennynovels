{
  "name": "@tenpennynovels/embeddings-worker",
  "version": "1.0.0",
  "description": "TenPennyNovels - Embeddings Worker",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsx watch -r dotenv/config src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "bull": "^4.16.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mongoose": "^9.1.6",
    "ollama": "^0.5.18",
    "redis": "^5.10.0",
    "slugify": "^1.6.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.2.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true
  }
}
