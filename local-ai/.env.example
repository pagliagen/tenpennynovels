# =============================================================================
# local-ai — Variabili d'Ambiente
# =============================================================================
# ATTENZIONE: questo file (.env vero) NON va committato (vedi .gitignore).
# Copiare in `.env` e valorizzare secondo il PROFILO di deploy (DEV o VPS).
#
# Il deploy di produzione SPLITTA i servizi:
#   - DEV (macchina locale): Ollama pesante + botai + character-gen + gateway
#   - VPS (produzione):      Ollama leggero + qa + gateway
# Ogni host ha il PROPRIO .env: i servizi che NON girano su quell'host si
# ignorano semplicemente (ENABLED_SERVICES + *_TARGET).
# =============================================================================

# ── Gateway ──
GATEWAY_PORT=9000
# File dei client (API key / HMAC / permessi). DEVE essere identico su DEV e VPS
# affinché l'auth nested (VPS gateway -> ngrok -> DEV gateway) passi trasparente.
# CLIENTS_FILE=/app/clients.json

# ── Servizi abilitati su QUESTO host ──
# DEV:  ENABLED_SERVICES=botai,character-gen
# VPS:  ENABLED_SERVICES=botai,qa,character-gen
#       (su VPS "botai" e "character-gen" restano abilitati ma puntano a ngrok)
ENABLED_SERVICES=botai,qa,character-gen

# ── Service targets ──
# DEV (rete Docker interna):
#   BOTAI_TARGET=http://botai:8080
#   CHAR_GEN_TARGET=http://character-gen:8130
#   QA_TARGET=http://qa:8090            # (solo se abiliti qa in dev)
#
# VPS (qa locale, botai/char-gen verso la macchina DEV via ngrok):
#   QA_TARGET=http://localhost:8090
#   BOTAI_TARGET=https://<tuo-ngrok>.ngrok-free.dev/botai
#   CHAR_GEN_TARGET=https://<tuo-ngrok>.ngrok-free.dev/character-gen
#   NB: il suffisso /botai e /character-gen serve perché il gateway VPS
#       strippa il prefisso; il gateway DEV se lo riaspetta. Con ngrok a
#       pagamento (2 tunnel) puoi invece puntare ai servizi grezzi senza suffisso.
BOTAI_TARGET=http://botai:8080
QA_TARGET=http://qa:8090
CHAR_GEN_TARGET=http://character-gen:8130

# ── Ollama ──
OLLAMA_URL=http://ollama:11434
# Modello ruolo creativo (dialoghi botai, generazione bot) — SOLO DEV (GPU/heavy).
#   DEV: OLLAMA_MODEL=gemma3:12b
#   VPS: OLLAMA_MODEL=qwen2.5:3b   # leggero per qa (RAG) su CPU
OLLAMA_MODEL=gemma3:12b
# Modello ruolo analitico (context analysis, JSON, character-gen). Fallback su OLLAMA_MODEL.
# OLLAMA_ANALYTICAL_MODEL=qwen3:8b
# Su VPS CPU-only: limita i thread per non affamare Mongo/WebSocket durante la generazione.
# OLLAMA_NUM_THREADS=3

# ── MongoDB interno a local-ai (usato da botai/character-gen; NON serve a qa) ──
MONGODB_URI=mongodb://mongodb:27017/local-ai

# ── LLM Provider (ollama | inception) ──
# AI_PROVIDER=ollama
# INCEPTION_API_KEY=
# INCEPTION_MODEL=mercury-2

# ── Optional ──
# CORS_ORIGIN=*
# LOG_LEVEL=info

# ── Test UI (solo con --profile test) ──
# TEST_UI_API_KEY=<apiKey-del-client-tpn-dev>
