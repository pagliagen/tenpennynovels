{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./services/unified-backend/src/shared/*"],
      "@database/*": ["./services/unified-backend/src/database/*"],
      "@modules/*": ["./services/unified-backend/src/modules/*"],
      "@config/*": ["./services/unified-backend/src/config/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "services/unified-backend/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
