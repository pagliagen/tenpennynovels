
# SOLO per `npm run simulate` (firma un token di prova): lo stesso valore del backend. Il servizio vero NON ha segreti di gioco:
# riceve con ogni evento l'indirizzo a cui rispondere e il token per farlo.
# BOT_SERVICE_SECRET=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b


LOG_LEVEL=info


# Schede dei bot (un file .json per bot) e quale bot sta in quale location
BOTS_DIR=./bots
MAPPING_FILE=./mapping.json

# Stato del servizio: umore dei bot e rapporti coi giocatori. Database SEPARATO da quello del game.
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/botservice?authSource=admin

# Servizi AI che questo processo avvia (separati da virgola): editorial, character-bot.
# Vuoto = NESSUNO (voluto: non accendere per svista un servizio sul server sbagliato).
# /health restituisce solo quelli abilitati e sani. Le variabili di un servizio (Redis, Mongo, segreto...)
# servono solo se quel servizio è abilitato.
ENABLED_SERVICES=editorial,character-bot

# HTTP interno (solo loopback): /health e /v1/<servizio>/<azione>. Lo raggiunge soltanto ai-gateway.
PORT=8788
HOST=127.0.0.1

# Servizio editorial (solo se abilitato)
# Il modello lo sceglie il servizio, mai la richiesta. Se manca vale OLLAMA_MODEL.
# EDITORIAL_MODEL=gemma4:12b
# Richieste in attesa oltre a quella in corso (oltre: 429) e tetto di token per richiesta
# EDITORIAL_MAX_QUEUE=4
# EDITORIAL_MAX_TOKENS=1200

# Gli indirizzi (origin) a cui il gioco può chiedere di rispondere, separati da virgola. Il token si manda SOLO a questi.
# Vuota = nessun evento accettato (fail-closed). http è lecito solo su localhost.
ALLOWED_REPLY_ORIGINS=http://localhost:3001,https://api.tenpennynovels.com
