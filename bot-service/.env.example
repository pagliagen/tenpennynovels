# Redis di tenpennynovels (stesso che usa unified-backend)
REDIS_URL=redis://localhost:6379

# unified-backend, raggiunto direttamente (NON dal gateway: /internal non è inoltrato)
BACKEND_URL=http://localhost:3001
# Stesso valore di BOT_SERVICE_SECRET in services/unified-backend/.env
BOT_SERVICE_SECRET=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b


LOG_LEVEL=info

# Schede dei bot (un file .json per bot) e quale bot sta in quale location
BOTS_DIR=./bots
MAPPING_FILE=./mapping.json

# Stato del servizio: umore dei bot e rapporti coi giocatori. Database SEPARATO da quello del game.
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/botservice?authSource=admin
