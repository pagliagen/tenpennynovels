{
  "name": "@tenpennynovels/bot-service",
  "version": "0.1.0",
  "private": true,
  "description": "Servizi AI locali: character-bot (bot personaggio) ed editorial (bozze per il gestionale), dietro un HTTP interno con /health",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "simulate": "tsx src/character-bot/scripts/publishTestEvent.ts",
    "scenario": "LOG_LEVEL=error tsx src/character-bot/scripts/scenario.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "mongodb": "^7.7.0",
    "p-queue": "^9.3.3",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
