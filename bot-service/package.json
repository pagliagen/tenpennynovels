{
  "name": "@tenpennynovels/bot-service",
  "version": "0.1.0",
  "private": true,
  "description": "Servizio locale: risponde con un LLM alle giocate in chat di location configurate",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "simulate": "tsx src/scripts/publishTestEvent.ts",
    "scenario": "LOG_LEVEL=error tsx src/scripts/scenario.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "mongodb": "^7.7.0",
    "p-queue": "^9.3.3",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
