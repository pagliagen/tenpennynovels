{
  "_meta": {
    "version": "2.1.0",
    "description": "Sistema autorizzazioni granulari TenpennyNovels",
    "lastUpdated": "2025-08-10"
  },
  "character_roles": {
    "personaggio": {
      "description": "Personaggio base - accesso limitato solo lettura",
      "permissions": {
        "dashboard": {
          "access": true,
          "detail": {
            "view_basic_stats": true,
            "view_user_count": false,
            "view_character_stats": true,
            "view_gameplay_stats": true
          }
        },
        "users": {
          "access": false,
          "detail": {}
        },
        "characters": {
          "access": false,
          "detail": {}
        },
        "content": {
          "access": false,
          "detail": {}
        },
        "documents": {
          "access": false,
          "detail": {}
        },
        "system": {
          "access": false,
          "detail": {}
        },
        "economy": {
          "access": false,
          "detail": {}
        },
        "locations": {
          "access": false,
          "detail": {}
        },
        "tickets": {
          "access": true,
          "detail": {
            "create": true,
            "read": true
          }
        }
      }
    },
    "moderatore": {
      "description": "Moderatore - gestione utenti e contenuti",
      "inherits": "personaggio",
      "permissions": {
        "dashboard": {
          "access": true,
          "detail": {
            "view_basic_stats": true,
            "view_user_count": true,
            "view_character_stats": true,
            "view_gameplay_stats": true
          }
        },
        "users": {
          "access": true,
          "detail": {
            "read": true,
            "ban": true
          }
        },
        "content": {
          "access": true,
          "detail": {
            "read": true,
            "create": true,
            "update": true,
            "delete": true,
            "publish": true
          }
        },
        "documents": {
          "access": true,
          "detail": {
            "read": true,
            "create": true,
            "update": true,
            "delete": true,
            "manage_groups": true
          }
        },
        "system": {
          "access": true,
          "detail": {
            "broadcast_messages": true
          }
        },
        "tickets": {
          "access": true,
          "detail": {
            "assign": true,
            "close": true
          }
        }
      }
    },
    "master": {
      "description": "Game Master - gestione gameplay completa",
      "inherits": "moderatore",
      "permissions": {
        "dashboard": {
          "access": true,
          "detail": {
            "view_financial_stats": true
          }
        },
        "characters": {
          "access": true,
          "detail": {
            "read": true,
            "approve": true,
            "reject": true,
            "edit": true
          }
        },
        "economy": {
          "access": true,
          "detail": {
            "view_transactions": true,
            "grant_money": true,
            "adjust_balances": true,
            "view_reports": true
          }
        },
        "locations": {
          "access": true,
          "detail": {
            "read": true,
            "create": true,
            "update": true,
            "manage_access": true
          }
        },
        "gamedata": {
          "access": true,
          "detail": {
            "read": true,
            "create": true,
            "update": true
          }
        },
        "skills": {
          "access": true,
          "detail": {
            "view": true,
            "create": true,
            "update": true
          }
        },
        "occupations": {
          "access": true,
          "detail": {
            "view": true,
            "create": true,
            "update": true
          }
        },
        "tickets": {
          "access": true,
          "detail": {
            "manage_all": true
          }
        }
      }
    },
    "amministratore": {
      "description": "Amministratore - accesso avanzato senza manutenzione",
      "inherits": "master",
      "permissions": {
        "dashboard": {
          "access": true,
          "detail": {
            "view_system_health": true,
            "view_activity_logs": true
          }
        },
        "users": {
          "access": true,
          "detail": {
            "update": true,
            "delete": false,
            "change_permissions": false
          }
        },
        "system": {
          "access": true,
          "detail": {
            "view_logs": true,
            "export_data": true,
            "maintenance_mode": false
          }
        },
        "locations": {
          "access": true,
          "detail": {
            "delete": true
          }
        },
        "gamedata": {
          "access": true,
          "detail": {
            "delete": true
          }
        },
        "skills": {
          "access": true,
          "detail": {
            "delete": true
          }
        },
        "occupations": {
          "access": true,
          "detail": {
            "delete": true
          }
        },
        "tickets": {
          "access": true,
          "detail": {
            "transfer": true,
            "internal_notes": true
          }
        }
      }
    }
  },
  "user_roles": {
    "user": {
      "description": "Utente standard"
    },
    "gestore": {
      "description": "Gestore - Accesso completo sistema (override tutti i permessi character)"
    }
  },
  "manager_permissions": {
    "manager.manage_user_permissions": {
      "description": "Gestire ruoli USER e gate admin panel (solo gestore)",
      "roles": ["gestore"]
    }
  },
