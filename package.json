{
  "name": "tenpennynovels-monorepo",
  "version": "1.0.0",
  "description": "TenPennyNovels Monorepo - GDR Call of Cthulhu via Chat",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "frontend:landing": "cd apps/landing && npm run dev",
    "frontend:game": "cd apps/game && npm run dev",
    "frontend:documents": "cd apps/documents && npm run dev",
    "frontend:management": "cd apps/management && npm run dev",
    "frontend:all": "concurrently -n \"landing,game,docs,mgmt\" -c \"blue,green,yellow,cyan\" \"npm run frontend:landing\" \"npm run frontend:game\" \"npm run frontend:documents\" \"npm run frontend:management\"",
    "backend:gateway": "cd services/api-gateway && npm run dev",
    "backend:unified": "cd services/unified-backend && npm run dev",
    "backend:embeddings": "cd services/embeddings-worker && npm run dev",
    "backend:all": "concurrently -n \"gateway,unified,embed\" -c \"blue,green,red\" \"npm run backend:gateway\" \"npm run backend:unified\" \"npm run backend:embeddings\"",
    "all": "concurrently \"npm run backend:all\" \"npm run frontend:all\"",
    "local-ai:start": "cd local-ai && docker compose up -d",
    "local-ai:stop": "cd local-ai && docker compose down",
    "local-ai:dev": "cd local-ai && npm run dev",
    "local-ai:logs": "cd local-ai && docker compose logs -f",
    "build:frontend:landing": "cd apps/landing && npm run build",
    "build:frontend:game": "cd apps/game && npm run build",
    "build:frontend:documents": "cd apps/documents && npm run build",
    "build:frontend:management": "cd apps/management && npm run build",
    "build:frontend:all": "npm run build:frontend:landing && npm run build:frontend:game && npm run build:frontend:documents && npm run build:frontend:management",
    "build:backend:gateway": "cd services/api-gateway && npm run build",
    "build:backend:unified": "cd services/unified-backend && npm run build",
    "build:backend:embeddings": "cd services/embeddings-worker && npm run build",
    "build:backend:all": "npm run build:backend:gateway && npm run build:backend:unified && npm run build:backend:embeddings",
    "build:all": "npm run build:backend:all && npm run build:frontend:all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:logs:unified": "docker compose logs -f unified-backend",
    "docker:logs:gateway": "docker compose logs -f api-gateway",
    "docker:logs:embeddings": "docker compose logs -f embeddings-worker",
    "seed:dev:users": "cd scripts/seeders && npm run seed:dev:users",
    "seed:dev:locations": "cd scripts/seeders && npm run seed:dev:locations",
    "seed:dev:items": "cd scripts/seeders && npm run seed:dev:items",
    "seed:dev:skills": "cd scripts/seeders && npm run seed:dev:skills",
    "seed:dev:occupations": "cd scripts/seeders && npm run seed:dev:occupations",
    "seed:dev:social-classes": "cd scripts/seeders && npm run seed:dev:social-classes",
    "seed:dev:documents": "cd scripts/seeders && npm run seed:dev:documents",
    "seed:dev:forum": "cd scripts/seeders && npm run seed:dev:forum",
    "seed:dev:system-config": "cd scripts/seeders && npm run seed:dev:system-config",
    "seed:dev:all": "cd scripts/seeders && npm run seed:dev:all",
    "seed:dev:all:force": "cd scripts/seeders && npm run seed:dev:all -- --force",
    "seed:prod:users": "cd scripts/seeders && npm run seed:prod:users",
    "seed:prod:locations": "cd scripts/seeders && npm run seed:prod:locations",
    "seed:prod:items": "cd scripts/seeders && npm run seed:prod:items",
    "seed:prod:skills": "cd scripts/seeders && npm run seed:prod:skills",
    "seed:prod:occupations": "cd scripts/seeders && npm run seed:prod:occupations",
    "seed:prod:social-classes": "cd scripts/seeders && npm run seed:prod:social-classes",
    "seed:prod:documents": "cd scripts/seeders && npm run seed:prod:documents",
    "seed:prod:forum": "cd scripts/seeders && npm run seed:prod:forum",
    "seed:prod:system-config": "cd scripts/seeders && npm run seed:prod:system-config",
    "seed:prod:all": "cd scripts/seeders && npm run seed:prod:all",
    "seed:prod:all:force": "cd scripts/seeders && npm run seed:prod:all -- --force",
    "export:dev:documents": "cd scripts/seeders && npm run export:dev:documents",
    "export:prod:documents": "cd scripts/seeders && npm run export:prod:documents",
    "sitemap:generate": "cd services/unified-backend && npm run generate:sitemap",
    "typecheck:gateway": "cd services/api-gateway && npm run type-check",
    "typecheck:unified": "cd services/unified-backend && npm run type-check",
    "typecheck:embeddings": "cd services/embeddings-worker && npm run type-check",
    "typecheck:backends": "npm run typecheck:gateway && npm run typecheck:unified && npm run typecheck:embeddings",
    "prepare": "husky"
  },
  "workspaces": [],
  "engines": {
    "node": ">=22.13.1"
  },
  "devDependencies": {
    "@types/yargs-parser": "^21.0.3",
    "commander": "^14.0.3",
    "concurrently": "^8.2.2",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "husky": "^9.1.7",
    "mongoose": "^9.1.6"
  }
}
