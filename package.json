{
  "name": "tenpennynovels",
  "version": "1.0.0",
  "description": "Victorian London RPG by Chat platform based on Call of Cthulhu",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "concurrently \"npm run dev:gateway\" \"npm run dev:game\" \"npm run dev:management\" \"npm run dev:auth\"",
    "dev:gateway": "npm run dev --workspace=services/api-gateway",
    "dev:game": "npm run dev --workspace=services/game-backend",
    "dev:management": "npm run dev --workspace=services/management-backend",
    "dev:auth": "npm run dev --workspace=services/authentication-backend",
    "dev:frontend": "concurrently \"npm run dev --workspace=apps/landing\" \"npm run dev --workspace=apps/game\" \"npm run dev --workspace=apps/documents\" \"npm run dev --workspace=apps/forum\" \"npm run dev --workspace=apps/management\" \"npm run dev --workspace=apps/tickets\"",
    "dev:landing": "npm run dev --workspace=apps/landing",
    "dev:game-frontend": "npm run dev --workspace=apps/game",
    "dev:documents": "npm run dev --workspace=apps/documents",
    "dev:forum": "npm run dev --workspace=apps/forum",
    "dev:management-frontend": "npm run dev --workspace=apps/management",
    "dev:tickets": "npm run dev --workspace=apps/tickets",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=@tenpennynovels/api-gateway && npm run build --workspace=@tenpennynovels/game-backend && npm run build --workspace=@tenpennynovels/management-backend && npm run build --workspace=@tenpennynovels/authentication-backend",
    "build:gateway": "npm run build --workspace=services/api-gateway",
    "build:game": "npm run build --workspace=services/game-backend",
    "build:management": "npm run build --workspace=services/management-backend",
    "build:auth": "npm run build --workspace=services/authentication-backend",
    "build:frontend": "npm run build --workspace=apps/landing && npm run build --workspace=apps/game && npm run build --workspace=apps/documents && npm run build --workspace=apps/forum && npm run build --workspace=apps/management && npm run build --workspace=apps/tickets",
    "build:landing": "npm run build --workspace=apps/landing",
    "build:game-frontend": "npm run build --workspace=apps/game",
    "build:documents": "npm run build --workspace=apps/documents",
    "build:forum": "npm run build --workspace=apps/forum",
    "build:management-frontend": "npm run build --workspace=apps/management",
    "build:tickets": "npm run build --workspace=apps/tickets",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "test": "npm run test --workspaces",
    "test:backend": "npm run test --workspace=services/api-gateway && npm run test --workspace=services/game-backend && npm run test --workspace=services/management-backend && npm run test --workspace=services/authentication-backend",
    "test:frontend": "npm run test --workspace=apps/landing && npm run test --workspace=apps/game && npm run test --workspace=apps/documents && npm run test --workspace=apps/forum && npm run test --workspace=apps/management && npm run test --workspace=apps/tickets",
    "test:integration": "jest --config=jest.integration.config.js",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "db:reset": "npm run reset --workspace=packages/database",
    "seed": "tsx scripts/seed.ts",
    "seed:locations": "tsx scripts/seed.ts locations",
    "seed:users": "tsx scripts/seed.ts users",
    "seed:skills": "tsx scripts/seed.ts skills",
    "seed:items": "tsx scripts/seed.ts items",
    "db:seed:system-configs": "tsx scripts/migrations/seed-system-configurations.ts",
    "db:check:configs": "tsx scripts/migrations/check-existing-configs.ts",
    "seed:documents": "tsx scripts/seed.ts documents",
    "seed:occupations": "tsx scripts/seed.ts occupations",
    "seed:system-config": "tsx scripts/seed-system-config.ts",
    "seed:force": "tsx scripts/seed.ts --force",
    "seed:build": "tsc -p scripts/tsconfig.json",
    "seed:prod": "npm run seed:build && node scripts/dist/seed.js",
    "docker:infra:up": "docker-compose -f docker-compose.infrastructure.yml up -d",
    "docker:infra:down": "docker-compose -f docker-compose.infrastructure.yml down",
    "docker:infra:logs": "docker-compose -f docker-compose.infrastructure.yml logs -f",
    "docker:infra:restart": "docker-compose -f docker-compose.infrastructure.yml restart",
    "docker:embeddings:build": "docker-compose -f docker-compose.infrastructure.yml build tenpennynovels-embeddings",
    "docker:embeddings:up": "docker-compose -f docker-compose.infrastructure.yml up -d tenpennynovels-embeddings",
    "docker:embeddings:logs": "docker-compose -f docker-compose.infrastructure.yml logs -f tenpennynovels-embeddings",
    "docker:embeddings:restart": "docker-compose -f docker-compose.infrastructure.yml restart tenpennynovels-embeddings",
    "docker:worker:build": "docker-compose -f docker-compose.infrastructure.yml build tenpennynovels-embeddings-worker",
    "docker:worker:up": "docker-compose -f docker-compose.infrastructure.yml up -d tenpennynovels-embeddings-worker",
    "docker:worker:logs": "docker-compose -f docker-compose.infrastructure.yml logs -f tenpennynovels-embeddings-worker",
    "docker:worker:restart": "docker-compose -f docker-compose.infrastructure.yml restart tenpennynovels-embeddings-worker",
    "worker:dev": "npm run dev --workspace=services/embeddings-worker",
    "embeddings:install": "cd services/embeddings-service && python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "embeddings:start": "cd services/embeddings-service && source venv/bin/activate && python3 embeddings_service.py",
    "embeddings:health": "curl -s http://127.0.0.1:5001/health | json_pp",
    "embeddings:download-model": "python3 services/embeddings-service/download_model.py",
    "embeddings:test": "echo '{\"action\":\"generate\",\"text\":\"test\"}' | python3 services/embeddings-service/embeddings_generator.py",
    "document:search": "tsx scripts/document-search.ts",
    "chat:import": "tsx scripts/import-chat-conversation.ts",
    "chat:search": "tsx scripts/chat-search.ts",
    "analytics:aggregate": "tsx scripts/analytics-aggregation.ts",
    "analytics:aggregate:date": "tsx scripts/analytics-aggregation.ts",
    "analytics:seed": "tsx scripts/seeders/AnalyticsSeeder.ts",
    "analytics:seed:full": "tsx scripts/seeders/AnalyticsSeeder.ts --days 30 --users 200 --force",
    "gameplay:seed": "tsx scripts/seeders/GameplaySeeder.ts",
    "test:geolocation": "tsx scripts/test-geolocation.ts",
    "verify:install": "node scripts/verify-installation.js",
    "verify:health": "curl -s http://localhost:8000/health",
    "docs:api": "node scripts/generate-api-docs.js",
    "pm2:setup": "npm install -g pm2 && cd process-dashboard && npm install",
    "pm2:start": "pm2 start ecosystem.dev.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:delete": "pm2 delete all",
    "pm2:list": "pm2 list",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "dashboard": "cd process-dashboard && npm start",
    "dashboard:install": "cd process-dashboard && npm install",
    "dev:pm2": "pm2 start ecosystem.dev.config.js && npm run dashboard",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "bash scripts/deploy.sh --dry-run",
    "deploy:backend": "bash scripts/deploy-backend.sh --all",
    "deploy:backend:gateway": "bash scripts/deploy-backend.sh gateway",
    "deploy:backend:auth": "bash scripts/deploy-backend.sh auth",
    "deploy:backend:game": "bash scripts/deploy-backend.sh game",
    "deploy:backend:management": "bash scripts/deploy-backend.sh management",
    "deploy:backend:embeddings": "bash scripts/deploy-backend.sh embeddings",
    "deploy:backend:worker": "bash scripts/deploy-backend.sh worker",
    "deploy:frontend": "bash scripts/deploy-frontend.sh --all",
    "deploy:frontend:landing": "bash scripts/deploy-frontend.sh landing",
    "deploy:frontend:game": "bash scripts/deploy-frontend.sh game",
    "deploy:frontend:documents": "bash scripts/deploy-frontend.sh documents",
    "deploy:frontend:forum": "bash scripts/deploy-frontend.sh forum",
    "deploy:frontend:management": "bash scripts/deploy-frontend.sh management",
    "deploy:frontend:tickets": "bash scripts/deploy-frontend.sh tickets",
    "deploy:health": "bash scripts/health-check.sh",
    "deploy:health:detailed": "bash scripts/health-check.sh --detailed",
    "deploy:health:continuous": "bash scripts/health-check.sh --continuous"
  },
  "engines": {
    "node": ">=22.13.1",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "csv-parser": "^3.2.0",
    "jest": "^30.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "node-cron": "^4.2.1",
    "slugify": "^1.6.6",
    "ua-parser-js": "^2.0.7",
    "uuid": "^13.0.0"
  }
}
