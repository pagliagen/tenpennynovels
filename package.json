{
  "name": "tenpennynovels-monorepo",
  "version": "1.0.0",
  "description": "TenPennyNovels Monorepo - GDR Call of Cthulhu via Chat",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "./start-dev.sh",
    "frontend:landing": "cd apps/landing && npm run dev",
    "frontend:game": "cd apps/game && npm run dev",
    "frontend:documents": "cd apps/documents && npm run dev",
    "frontend:management": "cd apps/management && npm run dev",
    "frontend:all": "concurrently -n \"landing,game,docs,mgmt\" -c \"blue,green,yellow,cyan\" \"npm run frontend:landing\" \"npm run frontend:game\" \"npm run frontend:documents\" \"npm run frontend:management\"",
    "backend:gateway": "cd services/api-gateway && npm run dev",
    "backend:unified": "cd services/unified-backend && npm run dev",
    "backend:botai": "cd services/botai-backend && npm run dev",
    "backend:embeddings": "cd services/embeddings-worker && npm run dev",
    "backend:cdn": "cd services/cdn-service && npm run dev",
    "backend:all": "concurrently -n \"gateway,unified,botai,embed,cdn\" -c \"blue,green,cyan,red,yellow\" \"npm run backend:gateway\" \"npm run backend:unified\" \"npm run backend:botai\" \"npm run backend:embeddings\" \"npm run backend:cdn\"",
    "all": "concurrently \"npm run backend:all\" \"npm run frontend:all\"",
    "build:frontend:landing": "cd apps/landing && npm run build",
    "build:frontend:game": "cd apps/game && npm run build",
    "build:frontend:documents": "cd apps/documents && npm run build",
    "build:frontend:management": "cd apps/management && npm run build",
    "build:frontend:all": "npm run build:frontend:landing && npm run build:frontend:game && npm run build:frontend:documents && npm run build:frontend:management",
    "build:backend:gateway": "cd services/api-gateway && npm run build",
    "build:backend:unified": "cd services/unified-backend && npm run build",
    "build:backend:botai": "cd services/botai-backend && npm run build",
    "build:backend:embeddings": "cd services/embeddings-worker && npm run build",
    "build:backend:cdn": "cd services/cdn-service && npm run build",
    "build:backend:all": "npm run build:backend:gateway && npm run build:backend:unified && npm run build:backend:embeddings",
    "build:all": "npm run build:backend:all && npm run build:frontend:all",
    "docker:infra:start": "docker-compose -f docker-compose.infrastructure.yml up -d",
    "docker:infra:stop": "docker-compose -f docker-compose.infrastructure.yml down",
    "docker:backends:build": "docker-compose -f docker-compose.backends.yml build",
    "docker:check": "scripts/check-infrastructure.sh",
    "docker:backends:start": "scripts/check-infrastructure.sh && docker-compose -f docker-compose.backends.yml up -d || echo '\n⚠️  Infrastructure not ready. Run: npm run docker:infra:start'",
    "docker:backends:stop": "docker-compose -f docker-compose.backends.yml down",
    "docker:all:start": "./docker-backends.sh start",
    "docker:all:stop": "./docker-backends.sh stop",
    "docker:restart": "./docker-backends.sh restart",
    "docker:status": "./docker-backends.sh status",
    "docker:logs": "docker-compose -f docker-compose.backends.yml logs -f",
    "docker:logs:gateway": "docker-compose -f docker-compose.backends.yml logs -f tenpennynovels-api-gateway",
    "docker:logs:auth": "docker-compose -f docker-compose.backends.yml logs -f tenpennynovels-auth-backend",
    "docker:logs:game": "docker-compose -f docker-compose.backends.yml logs -f tenpennynovels-game-backend",
    "docker:logs:management": "docker-compose -f docker-compose.backends.yml logs -f tenpennynovels-management-backend",
    "seed:admin": "cd scripts/seeders && npm run seed:users",
    "seed:users": "cd scripts/seeders && npm run seed:users",
    "seed:documents": "cd scripts/seeders && npm run seed:documents"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/yargs-parser": "^21.0.3",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.3",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "ioredis": "^5.9.3",
    "mongoose": "^9.1.6",
    "redis": "^5.11.0",
    "slugify": "^1.6.6",
    "uuid": "^13.0.0"
  }
}
