{
  "name": "@tenpennynovels/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Ingresso dei servizi AI: autentica, limita e smista le chiamate verso bot-service (editorial, character-bot). Oggi dietro ngrok, domani su un server dedicato.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "tunnel": "tsx src/tunnel.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
