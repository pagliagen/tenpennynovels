# ai-gateway: l'ingresso dei servizi AI. Autentica, limita e smista verso bot-service.

PORT=8787
# Loopback: ngrok (o nginx/Caddy sul server dedicato) gira sulla stessa macchina. NON 0.0.0.0.
HOST=127.0.0.1

# Segreto condiviso con il server di gioco (stesso valore di AI_GATEWAY_SECRET lì).
# Obbligatorio, min 32 caratteri. Generare con: openssl rand -hex 32
GATEWAY_SECRET=

# Dove ascolta bot-service (HTTP interno, solo loopback)
BOT_SERVICE_URL=http://127.0.0.1:8788

RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=65536
# Deve superare il tempo massimo di una generazione
UPSTREAM_TIMEOUT_MS=125000

LOG_LEVEL=info

# Solo per `npm run tunnel`: il dominio statico ngrok
# NGROK_URL=https://onomatopoeically-unforgeable-ozie.ngrok-free.dev
