              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Background: Educazione e interessi del personaggio"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Le sezioni seguenti approfondiscono istruzione, media e sport nell'epoca."
        }
      ]
    }
  ]
