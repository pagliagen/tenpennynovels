# Docker Environment Configuration for TenpennyNovels
# Copy this to .env and customize as needed

# Application Environment
NODE_ENV=development

# Security Secrets (CHANGE THESE IN PRODUCTION!)
NEXTAUTH_SECRET=your-super-secret-nextauth-key-minimum-32-characters-long
JWT_SECRET=10bd0952daa072fa3a53c5b7284b91bc8ed84e0b64e582cd215778d7e0fc5b1c
JWT_REFRESH_SECRET=a858e8f7557e0422e16813cce1c10bfa34c3853b57ef7d87b9a91471a4e105d2
JWT_EXPIRES_IN=24h

# Database Configuration
# Application backends connect to infrastructure services via localhost
# Format: mongodb://username:password@host:port/database?authSource=database
# Note: Special characters in password must be URL-encoded (! = %21, @ = %40, # = %23)
MONGODB_URI=mongodb://tenpennyuser:your-app-password@localhost:27017/tenpennynovels?authSource=tenpennynovels
REDIS_URL=redis://default:your-redis-password@localhost:6379

# ============================================================================
# INFRASTRUCTURE SERVICES CONFIGURATION
# ============================================================================
# These variables configure shared infrastructure services (MongoDB, Redis, Embeddings)
# Started via: ./docker-infrastructure.sh start

# ----------------------------------------------------------------------------
# MongoDB Infrastructure - Root Admin Credentials
# ----------------------------------------------------------------------------
# Root administrator credentials for MongoDB container initialization
# SECURITY: Change these in production! Never commit production .env files
MONGODB_INFRA_ROOT_USERNAME=admin
MONGODB_INFRA_ROOT_PASSWORD=your-secure-root-password-here
MONGODB_INFRA_DATABASE=tenpennynovels
MONGODB_INFRA_HOST=tenpennynovels-mongodb
MONGODB_INFRA_PORT=27017

# ----------------------------------------------------------------------------
# MongoDB Application User
# ----------------------------------------------------------------------------
# Application-level database user (created by init-mongo.js)
# This user has read/write access to the application database
MONGODB_APP_USERNAME=tenpennyuser
MONGODB_APP_PASSWORD=your-app-password-here
MONGODB_APP_DATABASE=tenpennynovels

# ----------------------------------------------------------------------------
# Redis Infrastructure
# ----------------------------------------------------------------------------
# Redis cache and message broker configuration
# SECURITY: Change password in production!
REDIS_INFRA_PASSWORD=your-redis-password-here
REDIS_INFRA_HOST=tenpennynovels-redis
REDIS_INFRA_PORT=6379

# ----------------------------------------------------------------------------
# Mongo Express (MongoDB Web UI)
# ----------------------------------------------------------------------------
# Web-based MongoDB administration interface
# Access at: http://localhost:8083
# SECURITY: Change all passwords in production! Consider disabling in prod.
MONGO_EXPRESS_ADMIN_USERNAME=admin
MONGO_EXPRESS_ADMIN_PASSWORD=your-admin-password-here
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=your-ui-password-here
MONGO_EXPRESS_PORT=8083

# ----------------------------------------------------------------------------
# Redis Commander (Redis Web UI)
# ----------------------------------------------------------------------------
# Web-based Redis administration interface
# Access at: http://localhost:8081
REDIS_COMMANDER_PORT=8081

# ----------------------------------------------------------------------------
# Embeddings Service
# ----------------------------------------------------------------------------
# Semantic search and document embedding microservice
# Port 5001: REST API for generating text embeddings
EMBEDDINGS_SERVICE_HOST=0.0.0.0
EMBEDDINGS_SERVICE_PORT=5001
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_LOG_LEVEL=INFO

# RAG "Bibliotecario" (Q&A sui documenti, via Ollama)
# L'inferenza CPU è limitata dalla banda di memoria: il tempo di risposta scala
# con la dimensione del modello. num_ctx esplicito evita che Ollama tronchi il
# prompt in silenzio; OLLAMA_THINK va lasciato a false perché i token di
# reasoning di qwen3 consumano l'intero budget prima della risposta utile.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
QA_MAX_ANSWER_TOKENS=250
QA_MAX_CONTEXT_CHARS=6000
QA_MAX_CHUNK_CHARS=1500

# HuggingFace Token (OPTIONAL but recommended)
# Get your token at: https://huggingface.co/settings/tokens
# Benefits:
# - Avoids rate limits during model downloads
# - Required for private models
# - Optional for public models (like paraphrase-multilingual-MiniLM-L12-v2)
# Leave empty for public models without rate limits concerns
HF_TOKEN=your_huggingface_token_here

# ----------------------------------------------------------------------------
# ElasticSearch - Full-text search
# ----------------------------------------------------------------------------
# Hybrid search combining keyword (ElasticSearch) + semantic (Qdrant)
# Port 9200: HTTP REST API
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=tenpennynovels

# SECURITY BEST PRACTICES:
#
# 1. Generate strong passwords using:
#    openssl rand -base64 32
#
# 2. For MongoDB passwords with special characters, use URL encoding:
#    ! = %21    @ = %40    # = %23    $ = %24
#    % = %25    ^ = %5E    & = %26    * = %2A
#
# 3. Never commit .env to version control
#
# 4. Use different credentials for development and production
#
# 5. Rotate credentials regularly in production

# Character Generation Configuration (Call of Cthulhu Rules)
CHARACTER_STAT_TOTAL_POINTS=400
CHARACTER_MAX_STATS_ABOVE_80=2
CHARACTER_SKILL_CAP=75
CHARACTER_FINAL_SKILL_CAP=80

# Character Minimums (Automatic Free Points)
CHARACTER_MIN_DEX=30
CHARACTER_MIN_CON=30
CHARACTER_MIN_STR=20
CHARACTER_MIN_SIZ=20
CHARACTER_MIN_EDU=15
CHARACTER_MIN_INT=15
CHARACTER_MIN_POW=15
CHARACTER_MIN_CHA=15

# Frontend Application URLs (400* ports)
NEXTAUTH_URL=http://localhost:4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
LANDING_URL=http://localhost:4000
GAME_URL=http://localhost:4001
DOCS_URL=http://localhost:4002
DOCUMENTS_URL=http://localhost:4002
FORUM_URL=http://localhost:4003
MANAGEMENT_URL=http://localhost:4004
TICKETS_URL=http://localhost:4005

# Backend Service URLs (300* ports)
API_GATEWAY_URL=http://localhost:8000
AUTH_BACKEND_URL=http://localhost:3000
GAME_BACKEND_URL=http://localhost:3001
MANAGEMENT_BACKEND_URL=http://localhost:3002
WEBSOCKET_URL=http://localhost:3001

# WebSocket Configuration
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=http://localhost:4000 

# Frontend Ports (400* series)
LANDING_PORT=4000
GAME_PORT=4001
DOCS_PORT=4002
FORUM_PORT=4003
MANAGEMENT_PORT=4004

# Backend Ports (300* series)
GAME_BACKEND_PORT=3001
MANAGEMENT_BACKEND_PORT=3002

# Infrastructure Service Ports
MONGODB_PORT=27017
REDIS_PORT=6379 

# External Access Ports (from host to container)
# These are the ports you'll use to access the application
HOST_LANDING_PORT=4000
HOST_GAME_PORT=4001
HOST_DOCS_PORT=4002
HOST_FORUM_PORT=4003
HOST_MANAGEMENT_PORT=4004
HOST_API_PORT=8000

# Development Settings
HOT_RELOAD=true
DEBUG_MODE=true

# Production Settings (set when NODE_ENV=production)
# SSL_CERT_PATH=/certs/fullchain.pem
# SSL_KEY_PATH=/certs/privkey.pem

# MOCK
EMAIL_MOCK=true
# Character Creation - Occupation Skill Bonuses (parametric)
NEXT_PUBLIC_OCCUPATION_REQUIRED_SKILL_MINIMUM=40
NEXT_PUBLIC_OCCUPATION_BONUS_SKILL_POINTS=30
