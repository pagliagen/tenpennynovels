# TenpennyNovels Documents App - Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Gateway URL (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URLs (for cross-linking)
NEXT_PUBLIC_LANDING_URL=http://localhost:4000
NEXT_PUBLIC_GAME_URL=http://localhost:4001
NEXT_PUBLIC_MANAGEMENT_URL=http://localhost:4004

# Optional: CDN URL for static assets
NEXT_PUBLIC_CDN_URL=

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# On-demand ISR revalidation (server-only, NON prefissare con NEXT_PUBLIC):
# deve combaciare col DOCUMENTS_REVALIDATE_SECRET di services/unified-backend/.env.
DOCUMENTS_REVALIDATE_SECRET=
