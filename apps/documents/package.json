{
  "name": "@tenpennynovels/documents",
  "version": "1.0.0",
  "description": "TenPennyNovels — front-end documentazione (knowledge base)",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4002 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4002 -H 0.0.0.0",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --passWithNoTests",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tanstack/react-query": "^5.62.11",
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.0.6",
    "isomorphic-dompurify": "^2.9.0",
    "js-cookie": "^3.0.5",
    "next": "^16.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.62.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "critters": "^0.0.25",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.4.2",
    "sass": "^1.97.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
