{
  "name": "@tenpennynovels/documents",
  "version": "1.0.0",
  "description": "TenPennyNovels — front-end documentazione (knowledge base)",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4002 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4002 -H 0.0.0.0",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --passWithNoTests",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "isomorphic-dompurify": "^3.19.0",
    "js-cookie": "^3.0.8",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "critters": "^0.0.25",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
