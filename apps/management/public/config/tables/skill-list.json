      "placeholder": "Filtra per categoria"
    },
    {
      "key": "visible",
      "label": "Visibile",
      "type": "select",
      "field": "visible",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "true", "label": "Visibili" },
        { "value": "false", "label": "Nascosti" }
      ],
      "placeholder": "Filtra per visibilità"
    },
    {
      "key": "defaultSkill",
      "label": "Default",
      "type": "select",
      "field": "defaultSkill",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "true", "label": "Default" },
        { "value": "false", "label": "Non Default" }
      ],
      "placeholder": "Filtra per default"
