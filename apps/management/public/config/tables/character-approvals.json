{
  "_meta": {
    "version": "1.0.0",
    "description": "Configurazione tabella approvazioni personaggi (ticket category=character_approval)",
    "lastUpdated": "2026-03-16"
  },
  "table": {
    "name": "character-approvals",
    "title": "Richieste Approvazione Personaggi",
    "icon": "📋",
    "searchable": true,
    "selectable": false,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "ticketNumber",
      "label": "#",
      "type": "number",
      "sortable": true,
      "width": "80px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "title",
      "label": "Titolo",
      "type": "text",
      "sortable": true,
      "width": "300px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "status",
      "label": "Status",
      "type": "text",
      "sortable": true,
      "render": { "type": "badge" }
    },
    {
      "key": "createdBy.characterName",
      "label": "Personaggio",
      "type": "text",
      "sortable": true,
      "render": {
        "type": "text"
      }
    },
    {
      "key": "assignedTo.username",
      "label": "Assegnato a",
      "type": "text",
      "sortable": true,
      "render": {
        "type": "text"
      }
    },
    {
      "key": "createdAt",
      "label": "Data Richiesta",
      "type": "datetime",
      "sortable": true,
      "render": { "type": "datetime" }
    }
  ],
  "filters": [
    {
      "key": "status",
      "label": "Status",
      "type": "select",
      "field": "status",
      "options": [
        { "value": "open", "label": "Aperto" },
        { "value": "assigned", "label": "Assegnato" },
        { "value": "in_progress", "label": "In Lavorazione" },
        { "value": "closed", "label": "Chiuso" }
      ]
    }
  ],
  "actions": [
    {
      "key": "view-details",
      "label": "Visualizza",
      "icon": "👁️"
    },
    {
      "key": "go-to-pending",
      "label": "In Attesa Approvazione",
      "icon": "📋"
    }
  ]
}
