{
  "_meta": {
    "version": "1.0.0",
    "description": "User ban management table configuration",
    "lastUpdated": "2025-08-09"
  },
  
  "table": {
    "name": "user-ban-list",
    "title": "User Ban Management",
    "icon": "⚖️",
    "searchable": true,
    "selectable": false,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },

  "columns": [
    {
      "key": "username",
      "label": "Username", 
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "150px",
      "render": {
        "type": "user_cell",
        "showSubtext": true,
        "subtextField": "displayName"
      }
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email", 
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "200px",
      "render": {
        "type": "email",
        "className": "emailColumn"
      }
    },
    {
      "key": "isBanned",
      "label": "Status",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "100px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "Banned", "className": "bannedBadge" },
        "falseValue": { "text": "Active", "className": "activeBadge" }
      }
    },
    {
      "key": "banReason",
      "label": "Ban Reason",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": true,
      "width": "300px",
      "validation": {
        "minLength": 10,
        "maxLength": 500
      },
      "render": {
        "type": "text",
        "truncate": true,
        "maxLength": 50,
        "className": "banReasonColumn",
        "emptyText": "-"
      }
    },
    {
      "key": "bannedUntil",
      "label": "Ban Duration",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "180px",
      "align": "center",
      "render": {
        "type": "ban_duration",
        "format": "relative",
        "permanentText": "Permanent",
        "className": "banDurationColumn"
      }
    },
    {
      "key": "banScopes",
      "label": "Ban Scopes",
      "type": "multi_select",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "200px",
      "options": [
        { "value": "chat_banned", "label": "Chat" },
        { "value": "game_banned", "label": "Game" },
        { "value": "forum_banned", "label": "Forum" },
        { "value": "documents_banned", "label": "Docs" },
        { "value": "full_site_banned", "label": "Full" }
      ],
      "render": {
        "type": "multi_scope_badges",
        "emptyText": "-",
        "className": "scopesList",
        "maxVisible": 3,
        "showCount": true,
        "badges": {
          "chat_banned": { "text": "Chat", "className": "chatBanBadge" },
          "game_banned": { "text": "Game", "className": "gameBanBadge" },
          "forum_banned": { "text": "Forum", "className": "forumBanBadge" },
          "documents_banned": { "text": "Docs", "className": "docsBanBadge" },
          "full_site_banned": { "text": "Full", "className": "fullBanBadge" }
        }
      }
    },
    {
      "key": "bannedAt",
      "label": "Banned At",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "datetime",
        "format": "short"
      }
    },
    {
      "key": "bannedBy",
      "label": "Banned By",
      "type": "text",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "120px",
      "render": {
        "type": "admin_username",
        "className": "adminColumn"
      }
    }
  ],

  "actions": [
    {
      "key": "ban",
      "label": "Ban User",
      "icon": "🚫",
      "type": "action",
      "visible": {
        "condition": "field_equals",
        "field": "isBanned",
        "value": false
      },
      "className": "banAction",
      "permission": "users.ban"
    },
    {
      "key": "unban",
      "label": "Unban",
      "icon": "✅", 
      "type": "action",
      "visible": {
        "condition": "field_equals",
        "field": "isBanned",
        "value": true
      },
      "className": "unbanAction",
      "permission": "users.ban",
      "confirmMessage": "Are you sure you want to unban {username}?"
    }
  ],

  "bulkActions": [],

  "sidePanels": {
    "ban": {
      "title": "Banna Utente: {username}",
      "subtitle": "Imposta le restrizioni per questo utente",
      "width": "medium",
      "fields": [
        {
          "key": "banReason",
          "label": "Motivo del Ban",
          "type": "textarea",
          "required": true,
          "defaultVisible": true,
          "placeholder": "Descrivi il motivo del ban...",
          "rows": 4,
          "validation": {
            "minLength": 10,
            "maxLength": 500
          }
        },
        {
          "key": "banDuration",
          "label": "Durata Ban",
          "type": "select",
          "required": true,
          "defaultVisible": true,
          "options": [
            { "value": "1day", "label": "1 Giorno" },
            { "value": "3days", "label": "3 Giorni" },
            { "value": "1week", "label": "1 Settimana" },
            { "value": "1month", "label": "1 Mese" },
            { "value": "permanent", "label": "Permanente" }
          ]
        },
        {
          "key": "banScopes",
          "label": "Ambiti del Ban",
          "type": "multi_checkbox",
          "required": true,
          "defaultVisible": true,
          "options": [
            { "value": "chat_banned", "label": "Chat/Messaggi" },
            { "value": "game_banned", "label": "Gioco/Gameplay" },
            { "value": "forum_banned", "label": "Forum/Discussioni" },
            { "value": "documents_banned", "label": "Documenti" },
            { "value": "full_site_banned", "label": "Tutto il Sito" }
          ],
          "layout": "grid",
          "columns": 2
        }
      ],
      "actions": [
        {
          "key": "save",
          "label": "Banna Utente",
          "type": "primary",
          "icon": "🚫"
        }
      ]
    }
  },

  "filters": [
    {
      "key": "status",
      "label": "User Status",
      "type": "select",
      "field": "isBanned",
      "options": [
        { "value": "all", "label": "All Users" },
        { "value": true, "label": "Banned Users Only" },
        { "value": false, "label": "Active Users Only" }
      ]
    },
    {
      "key": "scopes",
      "label": "Ban Scopes",
      "type": "multi_select",
      "field": "banScopes",
      "options": [
        { "value": "chat_banned", "label": "Chat Banned" },
        { "value": "game_banned", "label": "Game Banned" },
        { "value": "forum_banned", "label": "Forum Banned" },
        { "value": "documents_banned", "label": "Documents Banned" },
        { "value": "full_site_banned", "label": "Full Site Banned" }
      ],
      "filterMode": "contains_any"
    },
    {
      "key": "duration",
      "label": "Ban Type",
      "type": "select",
      "field": "bannedUntil",
      "options": [
        { "value": "all", "label": "All Bans" },
        { "value": "permanent", "label": "Permanent Bans" },
        { "value": "temporary", "label": "Temporary Bans" },
        { "value": "expired", "label": "Expired Bans" }
      ]
    },
    {
      "key": "username",
      "label": "Username",
      "type": "text",
      "field": "username",
      "placeholder": "Filter by username..."
    }
  ]
}