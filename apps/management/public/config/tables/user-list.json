{
  "_meta": {
    "version": "1.0.0",
    "description": "Configurazione tabella lista utenti",
    "lastUpdated": "2026-02-28"
  },
  "table": {
    "name": "user-list",
    "title": "Gestione Utenti",
    "icon": "👥",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "username",
      "label": "Username",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "150px",
      "render": {
        "type": "text",
        "className": "font-bold text-primary"
      }
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "200px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "displayName",
      "label": "Nome Visualizzato",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "accountStatus.isActive",
      "label": "Stato",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "100px",
      "render": {
        "type": "boolean"
      }
    },
    {
      "key": "accountStatus.isBanned",
      "label": "Ban",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "80px",
      "render": {
        "type": "boolean"
      }
    },
    {
      "key": "canAccessAdminPanel",
      "label": "Admin",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "80px",
      "render": {
        "type": "boolean"
      }
    },
    {
      "key": "userRoles",
      "label": "Ruoli Utente",
      "type": "text",
      "visible": true,
      "defaultVisible": false,
      "sortable": false,
      "width": "200px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "characters",
      "label": "Personaggi",
      "type": "number",
      "visible": true,
      "defaultVisible": true,
      "sortable": false,
      "width": "100px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "activity.lastLoginAt",
      "label": "Ultimo Login",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "datetime",
        "format": "relative"
      }
    },
    {
      "key": "registrationInfo.registeredAt",
      "label": "Registrato Il",
      "type": "datetime",
      "visible": true,
      "defaultVisible": false,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "datetime",
        "format": "date"
      }
    },
    {
      "key": "activity.messagesSent",
      "label": "Messaggi",
      "type": "number",
      "visible": true,
      "defaultVisible": false,
      "sortable": true,
      "width": "100px",
      "render": {
        "type": "number"
      }
    },
    {
      "key": "activity.moderationActions",
      "label": "Azioni Mod",
      "type": "number",
      "visible": true,
      "defaultVisible": false,
      "sortable": true,
      "width": "100px",
      "render": {
        "type": "number"
      }
    }
  ],
  "actions": [
    {
      "key": "edit",
      "label": "Modifica",
      "icon": "✏️",
      "type": "primary",
      "visible": true
    },
    {
      "key": "delete",
      "label": "Elimina",
      "icon": "🗑️",
      "type": "danger",
      "visible": true,
      "confirmMessage": "Sei sicuro di voler eliminare questo utente? Questa azione è irreversibile."
    }
  ],
  "bulkActions": [
    {
      "key": "bulk-activate",
      "label": "Attiva Selezionati",
      "icon": "✓",
      "type": "success"
    },
    {
      "key": "bulk-deactivate",
      "label": "Disattiva Selezionati",
      "icon": "✗",
      "type": "danger"
    }
  ],
  "filters": [
    {
      "key": "status",
      "label": "Stato Account",
      "type": "select",
      "field": "accountStatus.isActive",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "active", "label": "Attivi" },
        { "value": "inactive", "label": "Inattivi" },
        { "value": "banned", "label": "Bannati" }
      ],
      "placeholder": "Filtra per stato"
    },
    {
      "key": "adminAccess",
      "label": "Accesso Admin",
      "type": "select",
      "field": "canAccessAdminPanel",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": true, "label": "Admin" },
        { "value": false, "label": "Non Admin" }
      ],
      "placeholder": "Filtra per accesso admin"
    }
  ]
}
