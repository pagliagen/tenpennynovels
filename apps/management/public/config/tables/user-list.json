{
  "_meta": {
    "version": "1.0.0",
    "description": "User management table configuration",
    "lastUpdated": "2025-08-09"
  },
  
  "table": {
    "name": "user-list",
    "title": "User Management",
    "icon": "👥",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },

  "columns": [
    {
      "key": "username",
      "label": "Username", 
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "150px",
      "validation": {
        "minLength": 3,
        "maxLength": 50,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "render": {
        "type": "user_cell",
        "showSubtext": true,
        "subtextField": "displayName"
      }
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email", 
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "200px",
      "validation": {
        "email": true
      },
      "render": {
        "type": "email",
        "className": "emailColumn"
      }
    },
    {
      "key": "displayName",
      "label": "Display Name",
      "type": "text",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true, 
      "required": false,
      "width": "180px",
      "validation": {
        "maxLength": 100
      }
    },
    {
      "key": "canAccessAdminPanel",
      "label": "Admin",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "80px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "Admin", "className": "adminBadge" },
        "falseValue": { "text": "User", "className": "userBadge" }
      }
    },
    {
      "key": "userRoles", 
      "label": "User Roles",
      "type": "multi_select",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "120px",
      "options": [
        { "value": "user", "label": "User" },
        { "value": "gestore", "label": "Gestore" }
      ],
      "render": {
        "type": "multi_role_badges",
        "emptyText": "user",
        "className": "userRolesList",
        "maxVisible": 2,
        "showCount": false
      }
    },
    {
      "key": "characterRoles", 
      "label": "Character Roles",
      "type": "multi_select",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "160px",
      "options": [
        { "value": "personaggio", "label": "Personaggio" },
        { "value": "master", "label": "Master" },
        { "value": "moderatore", "label": "Moderatore" },
        { "value": "amministratore", "label": "Amministratore" }
      ],
      "render": {
        "type": "multi_role_badges",
        "emptyText": "personaggio",
        "className": "characterRolesList",
        "maxVisible": 3,
        "showCount": true
      }
    },
    {
      "key": "characters",
      "label": "Characters",
      "type": "array_length",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "100px",
      "align": "center",
      "render": {
        "type": "count",
        "className": "characterCount"
      }
    },
    {
      "key": "accountStatus",
      "label": "Status", 
      "type": "complex_status",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "100px",
      "align": "center",
      "render": {
        "type": "account_status_badge",
        "logic": {
          "banned": { "field": "isBanned", "value": true, "text": "Banned", "className": "banned" },
          "inactive": { "field": "isActive", "value": false, "text": "Inactive", "className": "inactive" },
          "active": { "field": "isActive", "value": true, "text": "Active", "className": "active" }
        },
        "priority": ["banned", "inactive", "active"]
      }
    },
    {
      "key": "registrationInfo.registeredAt",
      "label": "Registered",
      "type": "nested_datetime",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "datetime",
        "format": "short"
      }
    },
    {
      "key": "activity.lastLoginAt",
      "label": "Last Login",
      "type": "nested_datetime",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true, 
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "datetime",
        "format": "short",
        "nullable": true
      }
    },
    {
      "key": "activity.loginCount",
      "label": "Logins",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "80px",
      "align": "center"
    },
    {
      "key": "activity.messagesSent", 
      "label": "Messages",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "90px",
      "align": "center"
    },
    {
      "key": "multipleCharactersAllowed",
      "label": "Multi Characters",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "120px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "Allowed", "className": "allowedBadge" },
        "falseValue": { "text": "Single", "className": "singleBadge" }
      }
    }
  ],

  "actions": [
    {
      "key": "edit",
      "label": "Edit",
      "icon": "✏️",
      "type": "edit",
      "visible": true,
      "className": "editAction",
      "permission": "users.update"
    }
  ],

  "bulkActions": [],

  "editModal": {
    "title": "Edit User: {username}",
    "size": "medium",
    "fields": [
      {
        "key": "username",
        "label": "Username",
        "type": "text",
        "required": true,
        "validation": {
          "minLength": 3,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      {
        "key": "email", 
        "label": "Email",
        "type": "email",
        "required": true,
        "validation": {
          "email": true
        }
      },
      {
        "key": "displayName",
        "label": "Display Name", 
        "type": "text",
        "required": false,
        "validation": {
          "maxLength": 100
        }
      },
      {
        "key": "accountStatus.isActive",
        "label": "Account Active",
        "type": "checkbox", 
        "required": false
      }
    ]
  },

  "sidePanels": {
    "edit": {
      "title": "Modifica Utente: {username}",
      "subtitle": "Modifica le informazioni dell'utente selezionato",
      "width": "medium",
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "required": true,
          "defaultVisible": true,
          "validation": {
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email", 
          "required": true,
          "defaultVisible": true,
          "validation": {
            "email": true
          }
        },
        {
          "key": "displayName",
          "label": "Display Name",
          "type": "text",
          "required": false,
          "defaultVisible": false,
          "validation": {
            "maxLength": 100
          }
        },
        {
          "key": "accountStatus.isActive",
          "label": "Account Attivo",
          "type": "checkbox",
          "required": false,
          "defaultVisible": true
        },
        {
          "key": "canAccessAdminPanel",
          "label": "Accesso Pannello Admin",
          "type": "checkbox",
          "required": false,
          "defaultVisible": true
        },
        {
          "key": "userRoles",
          "label": "Ruoli Utente",
          "type": "multi_checkbox",
          "required": false,
          "defaultVisible": true,
          "options": [
            { "value": "user", "label": "User" },
            { "value": "gestore", "label": "Gestore" }
          ]
        },
        {
          "key": "multipleCharactersAllowed",
          "label": "Consenti Personaggi Multipli",
          "type": "checkbox",
          "required": false,
          "defaultVisible": true
        }
      ],
      "actions": [
        {
          "key": "save",
          "label": "Salva Modifiche",
          "type": "primary",
          "icon": "💾"
        }
      ]
    }
  },

  "filters": [
    {
      "key": "status",
      "label": "Status",
      "type": "select",
      "field": "accountStatus.isActive",
      "options": [
        { "value": "all", "label": "All Users" },
        { "value": true, "label": "Active Only" },
        { "value": false, "label": "Banned Only" }
      ]
    },
    {
      "key": "admin",
      "label": "Admin Access",
      "type": "select", 
      "field": "canAccessAdminPanel",
      "options": [
        { "value": "all", "label": "All Users" },
        { "value": true, "label": "Admins Only" },
        { "value": false, "label": "Regular Users" }
      ]
    },
    {
      "key": "userRoles",
      "label": "User Roles",
      "type": "multi_select",
      "field": "userRoles",
      "options": [
        { "value": "user", "label": "User" },
        { "value": "gestore", "label": "Gestore" }
      ],
      "filterMode": "contains_any"
    },
    {
      "key": "characterRoles",
      "label": "Character Roles",
      "type": "multi_select",
      "field": "characterRoles",
      "options": [
        { "value": "personaggio", "label": "Personaggio" },
        { "value": "master", "label": "Master" },
        { "value": "moderatore", "label": "Moderatore" },
        { "value": "amministratore", "label": "Amministratore" }
      ],
      "filterMode": "contains_any"
    }
  ]
}