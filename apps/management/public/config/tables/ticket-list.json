{
  "_meta": {
    "version": "1.0.0",
    "description": "Configurazione tabella lista ticket",
    "lastUpdated": "2026-03-16"
  },
  "table": {
    "name": "ticket-list",
    "title": "Gestione Ticket",
    "icon": "🎫",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "ticketNumber",
      "label": "#",
      "type": "number",
      "sortable": true,
      "width": "80px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "category",
      "label": "Categoria",
      "type": "text",
      "sortable": true,
      "render": { "type": "badge" }
    },
    {
      "key": "title",
      "label": "Titolo",
      "type": "text",
      "sortable": true,
      "width": "300px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "status",
      "label": "Status",
      "type": "text",
      "sortable": true,
      "render": { "type": "badge" }
    },
    {
      "key": "priority",
      "label": "Priorità",
      "type": "text",
      "sortable": true,
      "render": { "type": "badge" }
    },
    {
      "key": "createdBy.characterName",
      "label": "Character",
      "type": "text",
      "sortable": true,
      "render": {
        "type": "text"
      }
    },
    {
      "key": "assignedTo.username",
      "label": "Assegnato a",
      "type": "text",
      "sortable": true,
      "render": {
        "type": "text"
      }
    },
    {
      "key": "createdAt",
      "label": "Creato",
      "type": "datetime",
      "sortable": true,
      "render": { "type": "datetime" }
    }
  ],
  "filters": [
    {
      "key": "status",
      "label": "Status",
      "type": "select",
      "field": "status",
      "options": [
        { "value": "open", "label": "Aperto" },
        { "value": "assigned", "label": "Assegnato" },
        { "value": "in_progress", "label": "In Lavorazione" },
        { "value": "waiting_user", "label": "In Attesa" },
        { "value": "closed", "label": "Chiuso" },
        { "value": "reopened", "label": "Riaperto" }
      ]
    },
    {
      "key": "category",
      "label": "Categoria",
      "type": "select",
      "field": "category",
      "options": [
        { "value": "character_approval", "label": "Approvazione Personaggio" },
        { "value": "character_edit", "label": "Modifica Personaggio" },
        { "value": "quest_proposal", "label": "Proposta Trama" },
        { "value": "game_bug_report", "label": "Segnalazione Bug" },
        { "value": "improvement_suggestion", "label": "Suggerimento" }
      ]
    },
    {
      "key": "priority",
      "label": "Priorità",
      "type": "select",
      "field": "priority",
      "options": [
        { "value": "low", "label": "Bassa" },
        { "value": "medium", "label": "Media" },
        { "value": "high", "label": "Alta" },
        { "value": "critical", "label": "Critica" }
      ]
    }
  ],
  "actions": [
    {
      "key": "view-details",
      "label": "Visualizza",
      "icon": "👁️"
    }
  ],
  "bulkActions": [
    {
      "key": "bulk-close",
      "label": "Chiudi Selezionati"
    }
  ]
}
