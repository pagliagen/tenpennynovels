{
  "_meta": {
    "version": "1.0.0",
    "description": "Character pending approval management table configuration",
    "lastUpdated": "2025-08-10"
  },
  
  "table": {
    "name": "character-pending-approval-list",
    "title": "Character Pending Approval Management",
    "icon": "👤",
    "searchable": true,
    "selectable": false,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },

  "columns": [
    {
      "key": "characterName",
      "label": "Nome Personaggio", 
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "180px",
      "render": {
        "type": "custom",
        "renderer": "characterInfo"
      }
    },
    {
      "key": "username",
      "label": "Giocatore",
      "type": "text", 
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "150px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "submittedAt",
      "label": "Data Invio",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "custom",
        "renderer": "dateInfo"
      }
    },
    {
      "key": "status",
      "label": "Status",
      "type": "select",
      "visible": false,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": false,
      "required": false,
      "width": "120px",
      "align": "center",
      "options": [
        { "value": "PENDING_APPROVAL", "label": "Pending" }
      ],
      "render": {
        "type": "custom",
        "renderer": "statusBadge"
      }
    },
    {
      "key": "createdAt",
      "label": "Created",
      "type": "datetime",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "datetime",
        "format": "short"
      }
    }
  ],

  "actions": [
    {
      "key": "view_character",
      "label": "Vedi Dettagli",
      "icon": "👁️",
      "type": "action",
      "visible": true,
      "className": "actionButton",
      "permission": "manager.review_characters"
    }
  ],

  "bulkActions": [],

  "filters": [
    {
      "key": "socialClass",
      "label": "Social Class",
      "type": "select",
      "field": "socialClass",
      "options": [
        { "value": "all", "label": "All Classes" },
        { "value": "working", "label": "Working Class" },
        { "value": "middle", "label": "Middle Class" },
        { "value": "upper", "label": "Upper Class" }
      ]
    },
    {
      "key": "occupation",
      "label": "Occupation",
      "type": "text",
      "field": "occupation",
      "placeholder": "Search occupation..."
    },
    {
      "key": "submissionDate",
      "label": "Submission Date",
      "type": "date_range",
      "field": "submittedAt",
      "options": [
        { "value": "today", "label": "Today" },
        { "value": "week", "label": "This Week" },
        { "value": "month", "label": "This Month" }
      ]
    }
  ]
}