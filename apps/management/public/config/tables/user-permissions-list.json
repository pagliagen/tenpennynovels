{
  "_meta": {
    "version": "1.0.0",
    "description": "User permissions management table configuration",
    "lastUpdated": "2025-08-09"
  },
  
  "table": {
    "name": "user-permissions-list",
    "title": "User Permissions Management",
    "icon": "🔐",
    "searchable": true,
    "selectable": false,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },

  "columns": [
    {
      "key": "username",
      "label": "Username", 
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "150px",
      "render": {
        "type": "user_cell",
        "showSubtext": true,
        "subtextField": "displayName"
      }
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email", 
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "200px",
      "render": {
        "type": "email",
        "className": "emailColumn"
      }
    },
    {
      "key": "displayName",
      "label": "Display Name",
      "type": "text",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true, 
      "required": false,
      "width": "180px"
    },
    {
      "key": "userRole",
      "label": "User Role",
      "type": "select",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "120px",
      "options": [
        { "value": "user", "label": "User" },
        { "value": "gestore", "label": "Gestore" }
      ],
      "render": {
        "type": "badge",
        "className": "roleBadge",
        "variants": {
          "user": { "className": "userBadge" },
          "gestore": { "className": "gestoreBadge" }
        }
      }
    },
    {
      "key": "canAccessAdminPanel",
      "label": "Admin Access",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "120px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "Yes", "className": "adminBadge" },
        "falseValue": { "text": "No", "className": "userBadge" }
      }
    },
    {
      "key": "accountStatus",
      "label": "Status",
      "type": "complex_status",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "100px",
      "align": "center",
      "render": {
        "type": "account_status_badge",
        "logic": {
          "banned": { "field": "isBanned", "value": true, "text": "Banned", "className": "banned" },
          "inactive": { "field": "isActive", "value": false, "text": "Inactive", "className": "inactive" },
          "active": { "field": "isActive", "value": true, "text": "Active", "className": "active" }
        },
        "priority": ["banned", "inactive", "active"]
      }
    },
    {
      "key": "registrationInfo.registeredAt",
      "label": "Registered",
      "type": "nested_datetime",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "140px",
      "align": "center",
      "render": {
        "type": "datetime",
        "format": "short"
      }
    }
  ],

  "actions": [
    {
      "key": "edit_permissions",
      "label": "Edit Permissions",
      "icon": "✏️",
      "type": "action",
      "visible": true,
      "className": "actionButton",
      "permission": "manager.manage_user_permissions"
    }
  ],

  "bulkActions": [],

  "filters": [
    {
      "key": "userRole",
      "label": "User Role",
      "type": "select",
      "field": "userRole",
      "options": [
        { "value": "all", "label": "All Roles" },
        { "value": "user", "label": "User Only" },
        { "value": "gestore", "label": "Gestore Only" }
      ]
    },
    {
      "key": "admin",
      "label": "Admin Access",
      "type": "select", 
      "field": "canAccessAdminPanel",
      "options": [
        { "value": "all", "label": "All Users" },
        { "value": true, "label": "Admin Access" },
        { "value": false, "label": "No Admin Access" }
      ]
    },
    {
      "key": "status",
      "label": "Account Status",
      "type": "select",
      "field": "accountStatus.isActive",
      "options": [
        { "value": "all", "label": "All Users" },
        { "value": true, "label": "Active Only" },
        { "value": false, "label": "Banned Only" }
      ]
    }
  ]
}