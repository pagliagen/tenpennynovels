{
  "_meta": {
    "version": "1.0.0",
    "description": "Configurazione tabella personaggi in attesa di approvazione",
    "lastUpdated": "2026-03-03"
  },
  "table": {
    "name": "character-pending",
    "title": "Personaggi In Attesa di Approvazione",
    "icon": "⏳",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "fullName",
      "label": "Nome Completo",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "200px",
      "render": {
        "type": "text",
        "className": "font-bold text-primary"
      }
    },
    {
      "key": "user.username",
      "label": "Utente",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "150px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "age",
      "label": "Età",
      "type": "number",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "80px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "metadata.createdAt",
      "label": "Richiesto Il",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "datetime",
        "format": "relative"
      }
    }
  ],
  "actions": [
    {
      "key": "view-details",
      "label": "Dettagli",
      "icon": "👁️",
      "type": "secondary",
      "visible": true
    },
    {
      "key": "approve",
      "label": "Approva",
      "icon": "✅",
      "type": "success",
      "visible": true,
      "confirmMessage": "Sei sicuro di voler approvare questo personaggio?"
    },
    {
      "key": "reject",
      "label": "Rifiuta",
      "icon": "❌",
      "type": "danger",
      "visible": true,
      "confirmMessage": "Sei sicuro di voler rifiutare questo personaggio?"
    }
  ],
  "bulkActions": [
    {
      "key": "bulk-approve",
      "label": "Approva Selezionati",
      "icon": "✅",
      "type": "success"
    },
    {
      "key": "bulk-reject",
      "label": "Rifiuta Selezionati",
      "icon": "❌",
      "type": "danger"
    }
  ],
  "filters": []
}
