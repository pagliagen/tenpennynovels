{
  "_meta": {
    "version": "1.0.0",
    "description": "Configurazione tabella permessi personaggi",
    "lastUpdated": "2026-03-03"
  },
  "table": {
    "name": "character-permissions",
    "title": "Gestione Permessi Personaggi",
    "icon": "🔐",
    "searchable": true,
    "selectable": false,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "fullName",
      "label": "Personaggio",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "200px",
      "render": {
        "type": "text",
        "className": "font-bold text-primary"
      }
    },
    {
      "key": "user.username",
      "label": "Utente",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "150px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "isGestore",
      "label": "Gestore",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "100px",
      "render": {
        "type": "boolean"
      }
    },
    {
      "key": "characterRoles",
      "label": "Ruoli",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": false,
      "width": "250px",
      "render": {
        "type": "badge-list"
      }
    },
    {
      "key": "status",
      "label": "Stato Personaggio",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "150px",
      "render": {
        "type": "badge"
      }
    }
  ],
  "actions": [
    {
      "key": "edit-permissions",
      "label": "Modifica Permessi",
      "icon": "🔧",
      "type": "primary",
      "visible": true
    }
  ],
  "filters": [
    {
      "key": "status",
      "label": "Stato",
      "type": "select",
      "field": "status",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "approved", "label": "Approvati" },
        { "value": "pending", "label": "In Attesa" },
        { "value": "active", "label": "Attivi" }
      ],
      "placeholder": "Filtra per stato"
    },
    {
      "key": "isGestore",
      "label": "Solo Gestori",
      "type": "select",
      "field": "isGestore",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "true", "label": "Gestori" },
        { "value": "false", "label": "Non Gestori" }
      ],
      "placeholder": "Filtra gestori"
    }
  ]
}
