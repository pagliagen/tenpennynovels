{
  "_meta": {
    "version": "1.0.0",
    "description": "Location management table configuration",
    "lastUpdated": "2025-01-13"
  },

  "table": {
    "name": "location-list",
    "title": "Location Management",
    "icon": "🏛️",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },

  "columns": [
    {
      "key": "name",
      "label": "Name",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": true,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "250px",
      "render": {
        "type": "custom",
        "template": "hierarchical_name",
        "className": "locationName",
        "bold": true
      }
    },
    {
      "key": "parentLocationName",
      "label": "Parent",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": false,
      "required": false,
      "width": "180px",
      "render": {
        "type": "text",
        "className": "parentLocation",
        "emptyText": "—"
      }
    },
    {
      "key": "district",
      "label": "District",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "150px",
      "render": {
        "type": "badge",
        "className": "districtBadge"
      }
    },
    {
      "key": "locationLevel",
      "label": "Level",
      "type": "select",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": true,
      "width": "100px",
      "align": "center",
      "options": [
        { "value": "root", "label": "Root" },
        { "value": "district", "label": "District" },
        { "value": "location", "label": "Location" }
      ],
      "render": {
        "type": "badge",
        "className": "levelBadge"
      }
    },
    {
      "key": "settings.visible",
      "label": "Visible",
      "type": "nested_boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": true,
      "required": false,
      "width": "80px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "✓", "className": "visibleBadge" },
        "falseValue": { "text": "✗", "className": "hiddenBadge" }
      }
    },
    {
      "key": "settings.chat",
      "label": "Chat",
      "type": "nested_boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": false,
      "required": false,
      "width": "70px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "💬", "className": "chatEnabledBadge" },
        "falseValue": { "text": "—", "className": "chatDisabledBadge" }
      }
    },
    {
      "key": "settings.shop",
      "label": "Shop",
      "type": "nested_boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": false,
      "required": false,
      "width": "70px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "🛒", "className": "shopEnabledBadge" },
        "falseValue": { "text": "—", "className": "shopDisabledBadge" }
      }
    },
    {
      "key": "settings.private",
      "label": "Private",
      "type": "nested_boolean",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": true,
      "required": false,
      "width": "80px",
      "align": "center",
      "render": {
        "type": "badge",
        "trueValue": { "text": "🔒", "className": "privateBadge" },
        "falseValue": { "text": "🌐", "className": "publicBadge" }
      }
    },
    {
      "key": "statistics.totalVisits",
      "label": "Visits",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "80px",
      "align": "center",
      "render": {
        "type": "number",
        "format": "compact"
      }
    },
    {
      "key": "statistics.currentOccupants",
      "label": "Occupants",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": true,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "100px",
      "align": "center",
      "render": {
        "type": "badge",
        "className": "occupantsBadge"
      }
    },
    {
      "key": "statistics.uniqueVisitors",
      "label": "Unique Visitors",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "120px",
      "align": "center"
    },
    {
      "key": "statistics.messagesExchanged",
      "label": "Messages",
      "type": "nested_number",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "100px",
      "align": "center"
    },
    {
      "key": "statistics.averageStayTime",
      "label": "Avg Stay",
      "type": "nested_text",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": false,
      "filterable": false,
      "required": false,
      "width": "100px",
      "align": "center"
    },
    {
      "key": "sortOrder",
      "label": "Order",
      "type": "number",
      "visible": true,
      "defaultVisible": false,
      "alwaysVisible": false,
      "sortable": true,
      "filterable": false,
      "required": false,
      "width": "70px",
      "align": "center"
    }
  ],

  "actions": [
    {
      "key": "edit",
      "label": "Edit",
      "icon": "✏️",
      "type": "edit",
      "visible": true,
      "className": "editAction",
      "permission": "locations.update"
    },
    {
      "key": "access",
      "label": "Manage Access",
      "icon": "🔑",
      "type": "access",
      "visible": {
        "condition": "settings.private",
        "equals": true
      },
      "className": "accessAction",
      "permission": "locations.manage_access"
    },
    {
      "key": "delete",
      "label": "Delete",
      "icon": "🗑️",
      "type": "delete",
      "visible": true,
      "className": "deleteAction",
      "permission": "locations.delete",
      "confirmRequired": true,
      "confirmMessage": "Are you sure you want to delete this location?"
    }
  ],

  "bulkActions": [
    {
      "key": "bulk_show",
      "label": "Show Selected",
      "icon": "👁️",
      "type": "bulk",
      "className": "bulkShowAction",
      "permission": "locations.update"
    },
    {
      "key": "bulk_hide",
      "label": "Hide Selected",
      "icon": "👁️‍🗨️",
      "type": "bulk",
      "className": "bulkHideAction",
      "permission": "locations.update"
    },
    {
      "key": "bulk_delete",
      "label": "Delete Selected",
      "icon": "🗑️",
      "type": "bulk",
      "className": "bulkDeleteAction",
      "permission": "locations.delete",
      "confirmRequired": true,
      "confirmMessage": "Are you sure you want to delete {count} locations?"
    }
  ],

  "sidePanels": {
    "create": {
      "title": "Create New Location",
      "subtitle": "Add a new location to the Victorian London world",
      "width": "600px",
      "fields": [
        {
          "key": "name",
          "label": "Location Name",
          "type": "text",
          "required": true,
          "placeholder": "e.g., Whitechapel Hospital",
          "validation": {
            "minLength": 3,
            "maxLength": 100
          }
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "text",
          "required": true,
          "placeholder": "whitechapel-hospital",
          "helpText": "URL-friendly identifier (lowercase, no spaces)",
          "validation": {
            "pattern": "^[a-z0-9-]+$"
          }
        },
        {
          "key": "district",
          "label": "District",
          "type": "text",
          "required": true,
          "placeholder": "e.g., Whitechapel"
        },
        {
          "key": "locationLevel",
          "label": "Location Level",
          "type": "select",
          "required": true,
          "options": [
            { "value": "root", "label": "Root" },
            { "value": "district", "label": "District" },
            { "value": "location", "label": "Location" }
          ]
        },
        {
          "key": "parentLocation",
          "label": "Parent Location",
          "type": "text",
          "required": false,
          "placeholder": "Parent Location ID (optional)"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "textarea",
          "required": true,
          "rows": 4,
          "placeholder": "Describe this location...",
          "validation": {
            "maxLength": 2000
          }
        },
        {
          "key": "settings.visible",
          "label": "Visible",
          "type": "checkbox",
          "required": false,
          "defaultValue": true,
          "helpText": "Location appears in navigation"
        },
        {
          "key": "settings.chat",
          "label": "Chat Enabled",
          "type": "checkbox",
          "required": false,
          "defaultValue": true,
          "helpText": "Allow chat functionality"
        },
        {
          "key": "settings.shop",
          "label": "Shop Enabled",
          "type": "checkbox",
          "required": false,
          "defaultValue": false,
          "helpText": "Enable commerce/trading"
        },
        {
          "key": "settings.private",
          "label": "Private",
          "type": "checkbox",
          "required": false,
          "defaultValue": false,
          "helpText": "Activate access control system"
        },
        {
          "key": "sortOrder",
          "label": "Sort Order",
          "type": "number",
          "required": false,
          "defaultValue": 0,
          "min": 0
        }
      ],
      "actions": [
        {
          "key": "save",
          "label": "Create Location",
          "type": "primary",
          "icon": "✓"
        },
        {
          "key": "cancel",
          "label": "Cancel",
          "type": "secondary"
        }
      ]
    },
    "edit": {
      "title": "Edit Location: {name}",
      "subtitle": "Modify location settings and properties",
      "width": "600px",
      "fields": [
        {
          "key": "name",
          "label": "Location Name",
          "type": "text",
          "required": true,
          "validation": {
            "minLength": 3,
            "maxLength": 100
          }
        },
        {
          "key": "slug",
          "label": "Slug",
          "type": "text",
          "required": true,
          "disabled": true,
          "helpText": "Slug cannot be changed after creation"
        },
        {
          "key": "district",
          "label": "District",
          "type": "text",
          "required": true
        },
        {
          "key": "locationLevel",
          "label": "Location Level",
          "type": "select",
          "required": true,
          "options": [
            { "value": "root", "label": "Root" },
            { "value": "district", "label": "District" },
            { "value": "location", "label": "Location" }
          ]
        },
        {
          "key": "description",
          "label": "Description",
          "type": "textarea",
          "required": true,
          "rows": 4,
          "validation": {
            "maxLength": 2000
          }
        },
        {
          "key": "settings.visible",
          "label": "Visible",
          "type": "checkbox",
          "required": false,
          "helpText": "Location appears in navigation"
        },
        {
          "key": "settings.chat",
          "label": "Chat Enabled",
          "type": "checkbox",
          "required": false,
          "helpText": "Allow chat functionality"
        },
        {
          "key": "settings.shop",
          "label": "Shop Enabled",
          "type": "checkbox",
          "required": false,
          "helpText": "Enable commerce/trading"
        },
        {
          "key": "settings.private",
          "label": "Private",
          "type": "checkbox",
          "required": false,
          "helpText": "Activate access control system"
        },
        {
          "key": "sortOrder",
          "label": "Sort Order",
          "type": "number",
          "required": false,
          "min": 0
        }
      ],
      "actions": [
        {
          "key": "save",
          "label": "Save Changes",
          "type": "primary",
          "icon": "✓"
        },
        {
          "key": "cancel",
          "label": "Cancel",
          "type": "secondary"
        }
      ]
    },
    "access": {
      "title": "Manage Access: {name}",
      "subtitle": "Control who can access this private location",
      "width": "500px",
      "fields": [
        {
          "key": "ownerType",
          "label": "Owner Type",
          "type": "select",
          "required": false,
          "options": [
            { "value": "", "label": "No Owner" },
            { "value": "character", "label": "Character" },
            { "value": "corporation", "label": "Corporation" }
          ]
        },
        {
          "key": "ownerId",
          "label": "Owner ID",
          "type": "text",
          "required": false,
          "placeholder": "Character or Corporation ID"
        }
      ],
      "actions": [
        {
          "key": "save_access",
          "label": "Save Access Rules",
          "type": "primary",
          "icon": "✓"
        },
        {
          "key": "cancel",
          "label": "Cancel",
          "type": "secondary"
        }
      ]
    }
  }
}
