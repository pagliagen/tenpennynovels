{
  "_meta": {
    "version": "2.0.0",
    "description": "Configurazione tabella lista route/documenti (NEW ARCHITECTURE)",
    "lastUpdated": "2026-02-28",
    "architecture": "Document model (content)"
  },
  "table": {
    "name": "document-list",
    "title": "Gestione Documenti",
    "icon": "📄",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "title",
      "label": "Titolo",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "250px",
      "render": {
        "type": "text",
        "className": "font-bold text-primary"
      }
    },
    {
      "key": "path",
      "label": "Path",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "200px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "type",
      "label": "Tipo",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "120px",
      "render": {
        "type": "badge"
      }
    },
    {
      "key": "kind",
      "label": "Kind",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "100px",
      "render": {
        "type": "badge"
      }
    },
    {
      "key": "displayCategory",
      "label": "Categoria",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": false,
      "width": "150px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "enabled",
      "label": "Abilitato",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "90px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    },
    {
      "key": "isPublic",
      "label": "Pubblico",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "90px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    },
    {
      "key": "isDraft",
      "label": "Bozza",
      "type": "boolean",
      "visible": true,
      "defaultVisible": false,
      "sortable": false,
      "width": "80px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    },
    {
      "key": "metadata.createdAt",
      "label": "Creato Il",
      "type": "datetime",
      "visible": true,
      "defaultVisible": false,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "datetime",
        "format": "date"
      }
    },
    {
      "key": "metadata.updatedAt",
      "label": "Aggiornato Il",
      "type": "datetime",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "180px",
      "render": {
        "type": "datetime",
        "format": "relative"
      }
    }
  ],
  "actions": [
    {
      "key": "edit",
      "label": "Modifica",
      "icon": "✏️",
      "type": "primary",
      "visible": true
    },
    {
      "key": "view-content",
      "label": "Visualizza",
      "icon": "👁️",
      "type": "secondary",
      "visible": true
    },
    {
      "key": "delete",
      "label": "Elimina",
      "icon": "🗑️",
      "type": "danger",
      "visible": true,
      "confirmMessage": "Sei sicuro di voler eliminare questa route? Questa azione è irreversibile."
    }
  ],
  "bulkActions": [
    {
      "key": "bulk-enable",
      "label": "Abilita Selezionati",
      "icon": "✅",
      "type": "success"
    },
    {
      "key": "bulk-disable",
      "label": "Disabilita Selezionati",
      "icon": "❌",
      "type": "danger"
    }
  ],
  "filters": [
    {
      "key": "type",
      "label": "Tipo",
      "type": "select",
      "field": "type",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "ambientazione", "label": "Ambientazione" },
        { "value": "regolamento", "label": "Regolamento" }
      ],
      "placeholder": "Filtra per tipo"
    },
    {
      "key": "kind",
      "label": "Kind",
      "type": "select",
      "field": "kind",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "document", "label": "Document" },
        { "value": "category", "label": "Category" },
        { "value": "redirect", "label": "Redirect" }
      ],
      "placeholder": "Filtra per kind"
    },
    {
      "key": "enabled",
      "label": "Stato",
      "type": "select",
      "field": "enabled",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": true, "label": "Abilitato" },
        { "value": false, "label": "Disabilitato" }
      ],
      "placeholder": "Filtra per stato"
    }
  ]
}
