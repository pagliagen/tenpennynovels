{
  "_meta": {
    "version": "3.0.0",
    "description": "Configurazione tabella documenti (SubType architecture)",
    "lastUpdated": "2026-03-07",
    "architecture": "Document + DocumentSubtype"
  },
  "table": {
    "name": "document-list",
    "title": "Gestione Documenti",
    "icon": "📄",
    "searchable": true,
    "selectable": true,
    "pagination": {
      "defaultPageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100]
    }
  },
  "columns": [
    {
      "key": "title",
      "label": "Titolo",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "250px",
      "render": {
        "type": "text",
        "className": "font-bold text-primary"
      }
    },
    {
      "key": "path",
      "label": "Path",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "200px",
      "render": {
        "type": "text"
      }
    },
    {
      "key": "type",
      "label": "Tipo",
      "type": "text",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "120px",
      "render": {
        "type": "badge"
      }
    },
    {
      "key": "isPublic",
      "label": "Pubblico",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": true,
      "width": "90px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    },
    {
      "key": "isDraft",
      "label": "Bozza",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": false,
      "width": "80px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    },
    {
      "key": "visible",
      "label": "Visibile",
      "type": "boolean",
      "visible": true,
      "defaultVisible": true,
      "sortable": false,
      "width": "80px",
      "render": {
        "type": "badge",
        "trueValue": "Sì",
        "falseValue": "No"
      }
    }
  ],
  "actions": [
    {
      "key": "edit",
      "label": "Modifica",
      "icon": "✏️",
      "type": "primary",
      "visible": true
    },
    {
      "key": "view-content",
      "label": "Visualizza",
      "icon": "👁️",
      "type": "secondary",
      "visible": true
    },
    {
      "key": "delete",
      "label": "Elimina",
      "icon": "🗑️",
      "type": "danger",
      "visible": true,
      "confirmMessage": "Sei sicuro di voler eliminare questo documento? Questa azione è irreversibile."
    }
  ],
  "filters": [
    {
      "key": "type",
      "label": "Tipo",
      "type": "select",
      "field": "type",
      "options": [
        { "value": "", "label": "Tutti" },
        { "value": "ambientazione", "label": "Ambientazione" },
        { "value": "regolamento", "label": "Regolamento" }
      ],
      "placeholder": "Filtra per tipo"
    }
  ]
}
