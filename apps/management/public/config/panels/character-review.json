{
  "_meta": {
    "version": "1.0.0",
    "description": "Character review panel configuration",
    "lastUpdated": "2025-08-10"
  },

  "panel": {
    "name": "character-review",
    "title": "Character Review",
    "icon": "👤",
    "width": "large",
    "fetchEndpoint": "/admin/characters/{id}"
  },

  "sections": [
    {
      "key": "basic_info",
      "title": "Informazioni Base",
      "type": "info_grid",
      "visible": true,
      "fields": [
        {
          "key": "characterName",
          "label": "Nome",
          "type": "text",
          "visible": true,
          "editable": false
        },
        {
          "key": "characterSurname", 
          "label": "Cognome",
          "type": "text",
          "visible": true,
          "editable": false
        },
        {
          "key": "age",
          "label": "Età",
          "type": "number",
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "apparentAge",
          "label": "Età Apparente",
          "type": "number", 
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "gender",
          "label": "Genere",
          "type": "text",
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "occupation.name",
          "label": "Occupazione",
          "type": "nested_text",
          "visible": true,
          "editable": false,
          "fallback": "occupation"
        },
        {
          "key": "socialClass",
          "label": "Classe Sociale",
          "type": "text",
          "visible": true,
          "editable": false
        },
        {
          "key": "status",
          "label": "Stato",
          "type": "status_badge",
          "visible": true,
          "editable": false
        }
      ]
    },
    {
      "key": "player_info",
      "title": "Informazioni Giocatore",
      "type": "info_grid",
      "visible": true,
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "visible": true,
          "editable": false
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "visible": true,
          "editable": false
        },
        {
          "key": "submittedAt",
          "label": "Inviato il",
          "type": "datetime",
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "createdAt",
          "label": "Creato il",
          "type": "datetime",
          "visible": true,
          "editable": false
        }
      ]
    },
    {
      "key": "character_stats",
      "title": "Statistiche",
      "type": "stats_grid",
      "visible": true,
      "fields": [
        {
          "key": "stats.str",
          "label": "STR",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.dex",
          "label": "DEX", 
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.int",
          "label": "INT",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.con",
          "label": "CON",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.app",
          "label": "APP",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.pow",
          "label": "POW",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.siz",
          "label": "SIZ",
          "type": "nested_number",
          "visible": true,
          "editable": false
        },
        {
          "key": "stats.edu",
          "label": "EDU",
          "type": "nested_number",
          "visible": true,
          "editable": false
        }
      ]
    },
    {
      "key": "character_skills",
      "title": "Abilità",
      "type": "skills_list",
      "visible": true,
      "fields": [
        {
          "key": "skills",
          "label": "Skills",
          "type": "object_entries",
          "visible": true,
          "editable": false,
          "render": {
            "type": "skills_grid",
            "emptyText": "Nessuna abilità disponibile"
          }
        }
      ]
    },
    {
      "key": "character_equipment",
      "title": "Equipaggiamento",
      "type": "equipment_list",
      "visible": true,
      "fields": [
        {
          "key": "equipment",
          "label": "Equipment",
          "type": "array_objects",
          "visible": true,
          "editable": false,
          "render": {
            "type": "equipment_list",
            "emptyText": "Nessun equipaggiamento",
            "showDetails": true
          }
        }
      ]
    },
    {
      "key": "character_roles",
      "title": "Ruoli e Corporazioni",
      "type": "roles_section", 
      "visible": true,
      "fields": [
        {
          "key": "characterRoles",
          "label": "Ruoli di Gioco",
          "type": "array_badges",
          "visible": true,
          "editable": false,
          "render": {
            "type": "role_badges",
            "emptyText": "Nessun ruolo assegnato"
          }
        },
        {
          "key": "corporationMemberships",
          "label": "Corporazioni",
          "type": "array_badges",
          "visible": true,
          "editable": false,
          "render": {
            "type": "corporation_badges", 
            "emptyText": "Nessuna corporazione"
          }
        }
      ]
    },
    {
      "key": "character_background",
      "title": "Background",
      "type": "text_section",
      "visible": true,
      "fields": [
        {
          "key": "publicDescription",
          "label": "Background Pubblico",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessun background pubblico fornito"
          }
        },
        {
          "key": "privateDescription",
          "label": "Background Privato",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessun background privato fornito"
          }
        },
        {
          "key": "physicalDescription",
          "label": "Descrizione Fisica",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessuna descrizione fisica fornita"
          }
        },
        {
          "key": "motivations",
          "label": "Motivazioni",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessuna motivazione fornita"
          }
        },
        {
          "key": "fears",
          "label": "Paure",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessuna paura fornita"
          }
        }
      ]
    },
    {
      "key": "review_notes",
      "title": "Note di Revisione",
      "type": "notes_section",
      "visible": true,
      "fields": [
        {
          "key": "notes",
          "label": "Note Staff",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "multiline_text",
            "emptyText": "Nessuna nota"
          }
        },
        {
          "key": "rejectionReason",
          "label": "Motivo Respinta",
          "type": "long_text",
          "visible": true,
          "editable": false,
          "render": {
            "type": "conditional_text",
            "emptyText": "Non respinto",
            "rejectedEmptyText": "Nessun motivo fornito"
          }
        }
      ]
    },
    {
      "key": "timeline",
      "title": "Cronologia",
      "type": "timeline_section",
      "visible": true,
      "fields": [
        {
          "key": "createdAt",
          "label": "Creato",
          "type": "datetime",
          "visible": true,
          "editable": false
        },
        {
          "key": "submittedAt",
          "label": "Inviato",
          "type": "datetime",
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "reviewedAt",
          "label": "Revisionato",
          "type": "datetime",
          "visible": true,
          "editable": false,
          "nullable": true
        },
        {
          "key": "reviewedBy",
          "label": "Revisionato da",
          "type": "text",
          "visible": true,
          "editable": false,
          "nullable": true
        }
      ]
    }
  ],

  "profiles": {
    "character-list": {
      "description": "Read-only view for character list page",
      "sections": {
        "basic_info": { "visible": true },
        "player_info": { "visible": true },
        "character_stats": { "visible": true },
        "character_skills": { "visible": true },
        "character_equipment": { "visible": true },
        "character_roles": { "visible": true },
        "character_background": { "visible": true },
        "review_notes": { "visible": true },
        "timeline": { "visible": true }
      },
      "actions": [
        {
          "key": "close",
          "label": "Chiudi",
          "type": "secondary",
          "icon": "✕"
        }
      ]
    },
    "character-pending": {
      "description": "Editable view for character pending approval page",
      "sections": {
        "basic_info": { "visible": true },
        "player_info": { "visible": true },
        "character_stats": { "visible": true },
        "character_skills": { "visible": true },
        "character_equipment": { "visible": true },
        "character_roles": { "visible": true },
        "character_background": { "visible": true },
        "review_notes": { "visible": true },
        "timeline": { "visible": true },
        "feedback_section": {
          "visible": true,
          "title": "Feedback",
          "type": "feedback_section",
          "fields": [
            {
              "key": "feedback",
              "label": "Feedback/Note",
              "type": "textarea",
              "visible": true,
              "editable": true,
              "required": false,
              "placeholder": "Aggiungi feedback per approvazione o respinta (obbligatorio per respinta)...",
              "rows": 4
            }
          ]
        }
      },
      "actions": [
        {
          "key": "cancel",
          "label": "Annulla",
          "type": "secondary",
          "icon": "✕"
        },
        {
          "key": "reject_character",
          "label": "Respingi",
          "type": "danger",
          "icon": "❌"
        },
        {
          "key": "approve_character",
          "label": "Approva",
          "type": "primary",
          "icon": "✅"
        }
      ]
    }
  }
}