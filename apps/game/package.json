{
  "name": "@tenpennynovels/game",
  "version": "2.0.0",
  "description": "TenPennyNovels - Game Frontend (Architecture V2)",
  "author": "Gennaro Paglia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4001 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4001 -H 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "axios": "^1.18.1",
    "classnames": "^2.5.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.1.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "critters": "^0.0.25",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.17",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
